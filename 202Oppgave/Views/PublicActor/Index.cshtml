
@{
    ViewData["Title"] = "Min side";
}

<section class="provider-hero">
    <div class="container provider-hero-content">
        <div>
            <span class="provider-eyebrow">
                MIN SIDE – OFFENTLIG AKTØR
            </span>

            <h1>Hei, @ViewBag.FullName!</h1>

            <p>
                Få oversikt over registreringene dine,
                følg opp forespørsler og finn tilgjengelige ressurser.
            </p>
        </div>
    </div>
</section>

<partial name="_PublicActorNavigation" />

<section class="provider-overview">
    <div class="container">

        @* Statistikkort *@
        <div class="public-actor-stats">

            <div class="public-actor-stat-card">
                <i class="bi bi-layers" aria-hidden="true"></i>
                <div>
                    <strong>–</strong>
                    <span>Aktive behov</span>
                </div>
            </div>

            <div class="public-actor-stat-card">
                <i class="bi bi-envelope" aria-hidden="true"></i>
                <div>
                    <strong>–</strong>
                    <span>Under behandling</span>
                </div>
            </div>

            <div class="public-actor-stat-card">
                <i class="bi bi-check-circle" aria-hidden="true"></i>
                <div>
                    <strong>–</strong>
                    <span>Løst</span>
                </div>
            </div>

            <div class="public-actor-stat-card">
                <i class="bi bi-folder2-open" aria-hidden="true"></i>
                <div>
                    <strong>–</strong>
                    <span>Totalt</span>
                </div>
            </div>

        </div>

        @* Registreringsbanner *@
        <div class="public-actor-create-banner">

            <div>
                <h2>Registrer et nytt behov</h2>
                <p>
                    Meld inn utstyr, transport eller annen bistand
                    som trengs ved en hendelse.
                </p>
            </div>

            <div class="public-actor-banner-illustration" aria-hidden="true">
                <i class="bi bi-file-earmark-plus"></i>
            </div>

            <a asp-controller="Need"
               asp-action="Create"
               class="provider-add-button">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                Registrer behov
            </a>

        </div>

        @* Registreringsoversikt *@
        <div class="public-actor-list-header">

            <div>
                <h2>Behovsoversikt</h2>
                <p>Følg statusen på forespørslene dine.</p>
            </div>
        </div>

        @* Tomtilstand frem til databasekoblingen er klar *@
        <div class="public-actor-empty-state">
            <i class="bi bi-clipboard2-check" aria-hidden="true"></i>

            <h3>Behovsoversikten er ikke tilgjengelig ennå</h3>

            <p>
                Her vil du kunne se og følge opp dine registrerte behov
                når oversikten er koblet til databasen.
            </p>

            <a asp-controller="Need"
               asp-action="Create"
               class="provider-page-button">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                Opprett en registrering
            </a>
        </div>

    </div>
</section>

@section Head {
    <link rel="stylesheet"
          href="~/css/resource-provider.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/public-actor.css"
          asp-append-version="true" />
}

