
@*     
Forsiden – hero, handlingskort og oversikt.
Eier: Sarah (Frontend/UI).
Lenker til:
- Resource/Create og Resource/Index – Vetle
- Need/Create og Need/Index – Sindre
- Map/Index – Marius
*@

@{
    
    ViewData["Title"] = "Hjem";
}

@* ===== 1. Banner (hero) =====
   Stort banner med bakgrunnsbilde, tittel og undertittel. Ikke det samme som headeren.
   Tre lag oppå hverandre: bilde (.hero-bg), hvit overlay (.hero-overlay) og tekst
   (.hero-content). Bildet flyttes litt ved scrolling, se site.js (parallakse). *@
 
   
<section class="hero">
   
    @* bildet er bare pynt (tom alt). data-parallax er det site.js bruker for å finne det *@
    <img src="~/images/forsidelandskap.jpg" alt="" aria-hidden="true"
         class="hero-bg" data-parallax />
    <div class="hero-overlay" aria-hidden="true"></div>
 
    <div class="hero-content">
       
        @* "Sammen for Norge" og de tre fargede strekene (bare pynt) *@
        <p class="hero-kicker">Sammen for Norge</p>
        <ul class="hero-stripes" aria-hidden="true">
            <li class="stripe-1"></li>
            <li class="stripe-2"></li>
            <li class="stripe-3"></li>
        </ul>
 
        @* "Trygghet." har egen farge via span.accent (se site.css) *@
        <h1>Ressurser. Mennesker. <span class="accent">Trygghet.</span></h1>
        <p>Koble behov med ressurser - raskt og effektivt.</p>
    </div>
</section>
 
@* ===== 2. Hovedinnhold under banneret ===== *@
<div class="container home-content">
 
    @* --- Handlingskort ---
       To kort ved siden av hverandre. De ligger delvis over nedre kant av banneret
       (.action-cards i site.css) og legger seg under hverandre på nettbrett og mobil.
       .card--accent-* og .btn-circle er definert i components.css (Emma). *@
    
    <div class="grid-2 action-cards">
 
        @* Registrer behov, for offentlige aktører. Lenker til Need/Create (Sindre). *@
        <article class="card card--accent-red">
            <div class="card-text">
                <h2>Registrer behov</h2>
                <p>Offentlige aktører kan registrere behov for ressurser under en krisesituasjon.</p>
            </div>
            @* aria-label fordi knappen bare viser en pil *@
            <a class="btn-circle" asp-controller="Need" asp-action="Create"
               aria-label="Registrer behov">
                <span aria-hidden="true">→</span>
            </a>
        </article>
 
        @* Registrer ressurser, for ressursleverandører. Lenker til Resource/Create (Vetle). *@
        <article class="card card--accent-indigo">
            <div class="card-text">
                <h2>Registrer ressurser</h2>
                <p>Ressursleverandører kan registrere tilgjengelige ressurser under en krisesituasjon.</p>
            </div>
            <a class="btn-circle btn-circle--indigo" asp-controller="Resource" asp-action="Create"
               aria-label="Registrer ressurser">
                <span aria-hidden="true">→</span>
            </a>
        </article>
    </div>
 
    <h2 class="section-title">Se oversikt</h2>
 
    @* --- Oversiktskort ---
       Tre kort der hele kortet er en lenke. Legger seg under hverandre på mobil. *@
    
    <div class="grid-3">
 
        @* Resource/Index (Vetle) *@
        <a class="card card-link" asp-controller="Resource" asp-action="Index">
            <strong>Se alle ressurser</strong>
            <span>Utforsk tilgjengelige ressurser.</span>
        </a>
 
        @* Need/Index (Sindre) *@
        <a class="card card-link" asp-controller="Need" asp-action="Index">
            <strong>Se alle behov</strong>
            <span>Utforsk registrerte behov.</span>
        </a>
 
        @* Map/Index (Marius) *@
        <a class="card card-link" asp-controller="Kart" asp-action="Oversikt">
            <strong>Åpne kart</strong>
            <span>Se ressurser og behov på kartet.</span>
        </a>
    </div>
</div>
 