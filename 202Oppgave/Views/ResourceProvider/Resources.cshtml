@{
    ViewData["Title"] = "Administrer ressurser";
}

<partial name="_ProviderNavigation" />

<section class="provider-resources">
    <div class="container">

        <div class="provider-resources-header">
            <div>
                <p class="provider-page-eyebrow">RESSURSLEVERANDØR</p>
                <h1>Administrer ressurser</h1>
                <p class="provider-page-intro">
                    Se og administrer ressursene du har registrert.
                </p>
            </div>
        </div>

        <div class="provider-page-card">
            <div class="provider-page-card-header">
                <h2>Registrerte ressurser</h2>

                <a asp-controller="Resource"
                   asp-action="Create"
                   class="provider-page-button">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    Registrer ressurs
                </a>
            </div>

            <div class="provider-empty-state">
                <i class="bi bi-box-seam" aria-hidden="true"></i>
                <h3>Ingen ressurser å vise ennå</h3>
                <p>
                    Ressursene dine vises her når de er
                    koblet til brukerkontoen din.
                </p>
            </div>
        </div>

    </div>
</section>

@section Head {
    <link rel="stylesheet"
          href="~/css/resource-provider.css"
          asp-append-version="true" />
}

