@{
    ViewData["Title"] = "Min side";
}

<section class="provider-hero">
    <div class="container">
        <div class="provider-hero-top">
            <span> MIN SIDE – RESSURSLEVERANDØR </span>
            <span> class="provider-status">● Online</span>
        </div>

        <h1>Min oversikt</h1>
    
        <p>
            En samlet oversikt over dine ressurser og deres tilgjengelighet.
        </p>
    
    </div>
</section>

<nav class="provider-nav" aria-label="Navigasjon for ressursleverandør">
    <div class="container provider-nav-links">
        <a asp-controller="ResourceProvider"
           asp-action="Index"
           class="active"
           aria-current="page">
            Oversikt
        </a>

        <a asp-controller="ResourceProvider"
           asp-action="Resources">
            Mine ressurser
        </a>

        <a asp-controller="ResourceProvider"
           asp-action="Profile">
            Profil og innstillinger
        </a>
    </div>
</nav>

@section Head {
    <link rel="stylesheet" href="~/css/resource-provider.css" asp-append-version="true" />
}