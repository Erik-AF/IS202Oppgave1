@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<nav class="provider-nav" aria-label="Navigasjon for ressursleverandør">
    <div class="container provider-nav-links">
        <a asp-controller="ResourceProvider"
           asp-action="Index"
           class="@(currentAction == "Index" ? "active" : "")"
           aria-current="@(currentAction == "Index" ? "page" : null)">
            <i class="bi bi-grid-1x2" aria-hidden="true"></i>Oversikt
        </a>

        <a asp-controller="ResourceProvider"
           asp-action="Resources"
           class="@(currentAction == "Resources" ? "active" : "")"
           aria-current="@(currentAction == "Resources" ? "page" : null)">
            <i class="bi bi-box-seam" aria-hidden="true"></i>Mine ressurser
        </a>

        <a asp-controller="ResourceProvider"
           asp-action="Profile"
           class="@(currentAction == "Profile" ? "active" : "")"
           aria-current="@(currentAction == "Profile" ? "page" : null)">
            <i class="bi bi-person-gear" aria-hidden="true"></i>Profil og innstillinger
        </a>
    </div>
</nav>