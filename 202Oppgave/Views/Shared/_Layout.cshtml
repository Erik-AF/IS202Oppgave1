@* Felles sideramme med navigasjon, profilmeny og varsler for innlogget brukers egne behov. *@
@using System.Security.Claims
@inject _202Oppgave.DataAccess.Repositories.IAllocationRepository HeaderAllocationRepo

@{
    var notificationUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var canApproveOwnNeeds = User.IsInRole("PublicActor") || User.IsInRole("Admin");
    var pendingApprovalCount = canApproveOwnNeeds && !string.IsNullOrWhiteSpace(notificationUserId)
        ? (await HeaderAllocationRepo.GetPendingCountsByNeedAsync(notificationUserId)).Values.Sum()
        : 0;

    var current = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    /// Sammenligner kontrollernavnet uten hensyn til store og små bokstaver for aktivt menyvalg.
    bool IsActive(string controller) =>
        string.Equals(current, controller, StringComparison.OrdinalIgnoreCase);

    bool isHome = IsActive("Home") &&
        string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Index", StringComparison.OrdinalIgnoreCase);

    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    var needDesign =
        (IsActive("Need") &&
            (action.Equals("Index", StringComparison.OrdinalIgnoreCase)
            || action.Equals("Create", StringComparison.OrdinalIgnoreCase)
            || action.Equals("Edit", StringComparison.OrdinalIgnoreCase)
            || action.Equals("Confirmation", StringComparison.OrdinalIgnoreCase)))
        || (IsActive("Resource") &&
            (action.Equals("Index", StringComparison.OrdinalIgnoreCase)
            || action.Equals("Create", StringComparison.OrdinalIgnoreCase)
            || action.Equals("Details", StringComparison.OrdinalIgnoreCase)))
        || (IsActive("Allocation") &&
            (action.Equals("Create", StringComparison.OrdinalIgnoreCase)
            || action.Equals("FromNeed", StringComparison.OrdinalIgnoreCase)));

    var informationDesign =
        IsActive("Information") &&
        (action.Equals("Om", StringComparison.OrdinalIgnoreCase)
        || action.Equals("Hjelp", StringComparison.OrdinalIgnoreCase)
        || action.Equals("Kontakt", StringComparison.OrdinalIgnoreCase));

    var brandName = "Ko/ordinert";
    var brandTagline = "Ressurser. Mennesker. Trygghet.";
    var brandLogo = "~/images/koordinert-logo.png";

    var isAuthPage =
        IsActive("Account") &&
        (action.Equals("Login", StringComparison.OrdinalIgnoreCase)
        || action.Equals("Register", StringComparison.OrdinalIgnoreCase));

    var useOverlayHeader = isHome || isAuthPage;
    var sharedChrome = !useOverlayHeader;
    var sharedFooter = !isAuthPage;

}

<!DOCTYPE html>
<html lang="nb">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="theme-color" content="#122b35" />
    <meta name="description"
          content="Ko/ordinert samler lokale ressurser og behov. Finn oversikten, bidra med utstyr og se hvor hjelpen trengs." />

    <title>@ViewData["Title"] - Ko/ordinert</title>

        <link rel="stylesheet"
              href="~/css/site.css"
              asp-append-version="true"/>

        <link rel="stylesheet"
              href="https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/leaflet.draw.css"/>

    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

        @if (needDesign)
        {
            <link rel="stylesheet"
                  href="~/css/need.css"
                  asp-append-version="true"/>
        }

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    @if (!useOverlayHeader)
    {
        <link rel="stylesheet"
              href="~/css/beredskap.css"
              asp-append-version="true" />
    }

        @if (isAuthPage)
        {
            <link rel="stylesheet" href="~/css/account-auth.css" asp-append-version="true"/>
        }
        @if (informationDesign)
        {
            <link rel="stylesheet" href="~/css/information.css" asp-append-version="true"/>
        }

        @await RenderSectionAsync("Head", required: false)
        @if (sharedFooter)
        {
            <link rel="stylesheet" href="~/css/shared-chrome.css" asp-append-version="true" />
        }
    </head>

@{
    var bodyClass = $"design-concept page-{current.ToLowerInvariant()} action-{action.ToLowerInvariant()}";

    if (sharedChrome)
    {
        bodyClass += " shared-chrome";
    }
}

<body id="top" class="@bodyClass">

    <header class="site-header @(useOverlayHeader ? "site-header--overlay" : "")">
        <div class="container header-inner">

            <a class="brand"
               asp-controller="Home"
               asp-action="Index"
               aria-label="Ko/ordinert – til forsiden">

                <img class="brand-logo"
                     src="@Url.Content(brandLogo)"
                     alt=""
                     width="42"
                     height="42"/>

                <span class="brand-text">
                    <span class="brand-name">@brandName</span>
                    <span class="brand-tagline">
                        @(sharedChrome ? brandTagline : "Ressurser. Mennesker. Trygghet.")
                    </span>
                </span>
            </a>

            <button class="nav-toggle"
                    type="button"
                    aria-label="Åpne meny"
                    aria-expanded="false"
                    aria-controls="main-nav">
                <span aria-hidden="true">☰</span>
            </button>

            <nav id="main-nav"
                 class="main-nav"
                 aria-label="Hovedmeny">

                <a asp-controller="Home"
                   asp-action="Index"
                   aria-current="@(IsActive("Home") ? "page" : null)">
                    Hjem
                </a>

                @if (!User.IsInRole("ResourceProvider"))
                {
                    <a asp-controller="Resource"
                       asp-action="Index"
                       aria-current="@(IsActive("Resource") ? "page" : null)">
                        Ressurser
                    </a>
                }

                @if (!User.IsInRole("ResourceProvider"))
                {
                    <a asp-controller="Need"
                       asp-action="Index"
                       aria-current="@(IsActive("Need") ? "page" : null)">
                        Behov
                    </a>
                }

                <a asp-controller="Kart"
                   asp-action="Oversikt"
                   aria-current="@(IsActive("Kart") ? "page" : null)">
                    Kartoversikt
                </a>

                <a asp-controller="Information"
                   asp-action="Om"
                   aria-current="@(IsActive("Information") ? "page" : null)">
                    Om tjenesten
                </a>

                @if (User.Identity?.IsAuthenticated == true
                    && (canApproveOwnNeeds || User.IsInRole("ResourceProvider")))
                {
                    var profileController = canApproveOwnNeeds ? "PublicActor" : "ResourceProvider";
                    <details class="profile-menu">
                        <summary class="profile-menu-toggle" aria-label="Åpne profilmeny" title="Profilmeny">
                            <svg viewBox="0 0 64 64" width="32" height="32" aria-hidden="true" focusable="false">
                                <circle cx="32" cy="19" r="12" fill="currentColor" />
                                <path d="M9 58c1-15 10-23 23-23s22 8 23 23Z" fill="currentColor" />
                            </svg>
                            <partial name="_ApprovalBadge" model="pendingApprovalCount" />
                        </summary>
                        <div class="profile-menu-panel">
                            <a class="profile-menu-home" asp-controller="@profileController" asp-action="Index">
                                Min side <partial name="_ApprovalBadge" model="pendingApprovalCount" />
                            </a>
                            <a asp-controller="@profileController" asp-action="Profile">Innstillinger</a>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit">Logg ut</button>
                            </form>
                        </div>
                    </details>
                }
                else if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="nav-login" type="submit">Logg ut</button>
                    </form>
                }
                else
                {
                    <a class="nav-login" asp-controller="Account" asp-action="Login">Logg inn</a>
                }

            </nav>
        </div>
    </header>

    <main id="main-content"
          class="site-main"
          tabindex="-1">

        @if (!IsActive("ResourceProvider") &&
             !IsActive("PublicActor") &&
             TempData["Success"] is string successMessage)
        {
            <div class="container">
                <div class="alert alert-success" role="status">
                    @successMessage
                </div>
            </div>
        }

        @if (isAuthPage)
        {
            <div class="auth-page">
                <div class="auth-page__overlay">
                    @RenderBody()
                </div>
                <div class="auth-page__waves" aria-hidden="true">
                    <svg viewBox="0 0 1440 100"
                         preserveAspectRatio="none">
                        <path fill="#d9f1f0"
                              d="M0 35 C180 -15 300 105 480 65 S760 15 950 65 S1230 90 1440 20 L1440 100 L0 100 Z"/>
                        <path fill="#9edbd7" fill-opacity=".8"
                              d="M0 85 C200 45 310 115 520 80 S820 105 1030 65 S1270 110 1440 55 L1440 100 L0 100 Z"/>
                    </svg>
                </div>
            </div>
        }

        else if (IsActive("Account"))
        {
            <div class="container account-shell">

                <aside class="account-story">
                    <p class="eyebrow">En del av fellesskapet</p>
                    <h2>Små bidrag.<br/>Stor forskjell.</h2>
                    <p>Sammen gjør vi lokale ressurser synlige når noen trenger dem.</p>
                    <img src="~/images/forsidelandskap.jpg"
                         alt="Norsk kystsamfunn ved fjell og sjø"/>
                </aside>

                <section class="account-panel">
                    @RenderBody()
                </section>
            </div>
        }
        else
        {
            @RenderBody()
        }

    </main>

    <footer class="site-footer @(sharedFooter ? "shared-footer" : "")">
        <div class="container footer-main">

            <div class="footer-brand-col">
                @if (sharedFooter)
                {
                    <a class="footer-brand footer-brand-lockup" asp-controller="Home" asp-action="Index">
                        <img src="@Url.Content(brandLogo)" alt="" width="52" height="52" />
                        <span>@brandName<small>@brandTagline</small></span>
                    </a>
                }
                else
                {
                <a class="footer-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    Ko/ordinert
                    <svg class="icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M7 17L17 7M8 7h9v9" />
                    </svg>
                </a>
                }

                <p class="footer-tagline">
                    God beredskap begynner med mennesker som finner hverandre.
                </p>

                <p class="footer-small">
                    Et studentprosjekt av gruppe 7 ved Universitetet i Agder.
                </p>
            </div>

            <nav class="footer-col" aria-label="Finn frem">
                <p class="eyebrow">Finn frem</p>
                <ul>
                    @if (!User.IsInRole("ResourceProvider"))
                    {
                        <li>
                            <a asp-controller="Resource"
                               asp-action="Index">
                                Tilgjengelige ressurser
                            </a>
                        </li>
                    }
                    <li>
                        <a asp-controller="Need"
                           asp-action="Index">
                            Registrerte behov
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Kart"
                           asp-action="Oversikt">
                            Åpne kartoversikten
                        </a>
                    </li>
                </ul>
            </nav>

            <nav class="footer-col" aria-label="Vi hjelper deg">
                <p class="eyebrow">Vi hjelper deg</p>
                <ul>
                    <li>
                        <a asp-controller="Information"
                           asp-action="Om">
                            Om Ko/ordinert
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Information"
                           asp-action="Hjelp">
                            @(sharedFooter ? "Slik bruker du tjenesten ↗" : "Spørsmål og svar")
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Information"
                           asp-action="Kontakt">
                            Kontakt oss
                        </a>
                    </li>
                </ul>
            </nav>
        </div>

        <div class="container footer-bottom">
            <p>© @DateTime.Now.Year Ko/ordinert</p>
            <p>Sammen for et mer robust lokalsamfunn</p>
            <a href="#main-content">
                Til toppen
                <svg class="icon"
                     viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M12 19V5M6 11l6-6 6 6" />
                </svg>
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/map-layers.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/leaflet.draw.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="~/js/beredskap.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    </body>
    </html>
