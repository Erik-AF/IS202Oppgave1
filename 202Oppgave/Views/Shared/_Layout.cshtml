@{
    var current = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool IsActive(string controller) => string.Equals(current, controller, StringComparison.OrdinalIgnoreCase);
    // Behovsdesignet lastes kun for sidene som bruker det.
    var needDesign = IsActive("Need") && (action.Equals("Index", StringComparison.OrdinalIgnoreCase)
        || action.Equals("Create", StringComparison.OrdinalIgnoreCase) || action.Equals("Edit", StringComparison.OrdinalIgnoreCase));
    var brandName = "Ko/ordinert";
    var brandTagline = "Kart. Behov. Ressurser. Sammen.";
    var brandLogo = "~/images/logo-koordinert.svg";

    var isAuthPage = IsActive("Account") && (action.Equals("Login", StringComparison.OrdinalIgnoreCase) || action.Equals("Register", StringComparison.OrdinalIgnoreCase));


}
<!DOCTYPE html>
<html lang="nb">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#122b35" />
    <meta name="description" content="Ko/ordinert samler lokale ressurser og behov. Finn oversikten, bidra med utstyr og se hvor hjelpen trengs." />
    <title>@ViewData["Title"] – @brandName</title>
    <link rel="icon" href="@Url.Content(brandLogo)" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/leaflet.draw.css" />
    @await RenderSectionAsync("Head", required: false)
    @* Felles design lastes sist slik at alle sidene får samme typografi og kontroller. *@
    <link rel="stylesheet" href="~/css/beredskap.css" asp-append-version="true" />
    @if (needDesign)
    {
        <link rel="stylesheet" href="~/css/need.css" asp-append-version="true" />
    }

    @if (isAuthPage)
    {
        <link rel="stylesheet" href="~/css/account-auth.css" asp-append-version="true" />
    }

</head>
<body class="design-concept page-@current.ToLowerInvariant() action-@action.ToLowerInvariant()">
    <a class="skip-link" href="#main-content">Hopp til innhold</a>
    <div class="utility-bar"><div class="container"><span>Et felles løft for lokal beredskap</span><a asp-controller="Information" asp-action="Hjelp">Slik bruker du tjenesten ↗</a></div></div>
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="@(brandName + " – til forsiden")">
                <img class="brand-logo" src="@Url.Content(brandLogo)" alt="" width="42" height="42" />
                <span>@brandName<small>@brandTagline</small></span>
            </a>
            <button class="nav-toggle" type="button" aria-label="Åpne meny" aria-expanded="false" aria-controls="main-nav">Meny <span aria-hidden="true">☰</span></button>
            <nav id="main-nav" class="main-nav" aria-label="Hovedmeny">
                <a asp-controller="Home" asp-action="Index" aria-current="@(IsActive("Home") ? "page" : null)">Hjem</a>
                <a asp-controller="Resource" asp-action="Index" aria-current="@(IsActive("Resource") ? "page" : null)">Ressurser</a>
                <a asp-controller="Need" asp-action="Index" aria-current="@(IsActive("Need") ? "page" : null)">Behov</a>
                <a asp-controller="Kart" asp-action="Oversikt" aria-current="@(IsActive("Kart") ? "page" : null)">Kartoversikt</a>
                <a asp-controller="Information" asp-action="Om" aria-current="@(IsActive("Information") ? "page" : null)">Om tjenesten</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="nav-login" type="submit" title="@User.Identity.Name">Logg ut ↗</button>
                    </form>
                }
                else
                {
                    <a class="nav-login" asp-controller="Account" asp-action="Login">Logg inn ↗</a>
                }
            </nav>
        </div>
    </header>
    <main id="main-content" class="site-main" tabindex="-1">
        @if (TempData["Success"] is string successMessage)
        {
            <div class="container"><div class="alert alert-success" role="status">@successMessage</div></div>
        }

        @if (isAuthPage)
        {
            <div class="auth-page">
                <div class="auth-page__overlay">
                    @RenderBody()
                </div>
                <div class="auth-page__waves" aria-hidden="true">
                    <svg viewBox="0 0 1440 100"
                         preserveAspectRatio="none">
                        <path fill="#d9f1f0"
                              d="M0 35 C180 -15 300 105 480 65 S760 15 950 65 S1230 90 1440 20 L1440 100 L0 100 Z" />
                        <path fill="#9edbd7" fill-opacity=".8"
                              d="M0 85 C200 45 310 115 520 80 S820 105 1030 65 S1270 110 1440 55 L1440 100 L0 100 Z" />
                    </svg>
                </div>
            </div>
        }
        else if (IsActive("Account"))
        {
            <div class="container account-shell">
                <aside class="account-story">
                    <p class="eyebrow">En del av fellesskapet</p>
                    <h2>Små bidrag.<br />Stor forskjell.</h2>
                    <p>Sammen gjør vi lokale ressurser synlige når noen trenger dem.</p>
                    <img src="~/images/forsidelandskap.jpg"
                         alt="Norsk kystsamfunn ved fjell og sjø" />
                </aside>
                <section class="account-panel">
                    @RenderBody()
                </section>
            </div>
        }
        else
        {
            @RenderBody()
        }

    </main>
    <footer class="site-footer">
        <div class="container footer-grid">
            <div>
                <a class="footer-brand footer-brand-lockup" asp-controller="Home" asp-action="Index">
                    <img src="@Url.Content(brandLogo)" alt="" width="52" height="52" />
                    <span>@brandName<small>@brandTagline</small></span>
                </a>
                <span class="project-note">Et studentprosjekt ved Universitetet i Agder.</span>
            </div>
            <nav aria-label="Utforsk"><h2>Finn frem</h2><a asp-controller="Resource" asp-action="Index">Tilgjengelige ressurser</a><a asp-controller="Need" asp-action="Index">Registrerte behov</a><a asp-controller="Kart" asp-action="Oversikt">Åpne kartoversikten</a></nav>
            <nav aria-label="Om tjenesten"><h2>Vi hjelper deg</h2><a asp-controller="Information" asp-action="Om">Om @brandName</a><a asp-controller="Information" asp-action="Hjelp">Spørsmål og svar</a><a asp-controller="Information" asp-action="Kontakt">Kontakt oss</a></nav>
        </div>
        <div class="container footer-bottom"><span>© @DateTime.Now.Year @brandName</span><span>Sammen for et mer robust lokalsamfunn</span><a href="#main-content">Til toppen ↑</a></div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://unpkg.com/leaflet@@1.9.4/dist/leaflet.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/leaflet.draw.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/beredskap.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
