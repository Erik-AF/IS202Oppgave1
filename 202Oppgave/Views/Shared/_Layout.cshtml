@* 

_Layout.cshtml – felles layout for hele applikasjonen.
Eier: Sarah (Frontend/UI).

Inneholder header, navigasjon, hovedinnhold og footer.
Enkeltsider kan legge til egne styles/scripts gjennom
@section Head og @section Scripts.

*@

@{
    // Finner hvilken controller som er aktiv, slik at riktig lenke
    // kan markeres som aktiv i menyen.
    
    var current = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    
    // Hjelpemetode for å sjekke om en menylenke tilhører aktiv controller.
    
    bool IsActive(string controller) =>
        string.Equals(current, controller, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="nb">

@* ========== 1. HEAD ==========
  Felles metadata, sidetittel og stylesheets.
    *@

<head>
    
    @* Tegnsett og mobiltilpasning. "viewport" er det som gjør at siden blir responsiv på mobil. *@
    
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    
    @* SideTittelen settes i det enkelte viewet via ViewData["Title"]. *@
    
    <title>@ViewData["Title"] – CrisisSystem</title>
    
    @* Felles styling. Enkeltsider kan legge til CSS via @section Head. *@
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true"/>
    
    @* Plass for ekstra <head>-innhold fra andre views (f.eks. Leaflet-CSS på kartsiden). Valgfri. *@
    
    @await RenderSectionAsync("Head", required: false)
</head>

@* ========== 2. BODY ==========
   Alt brukeren ser: header, hovedinnhold og footer. *@

<body>

@* ---------- 2a. HEADER ----------
       Felles header og navigasjon for alle sider. *@

<header class="site-header">
    <div class="container header-inner">
        
        @* Logo – går alltid tilbake til forsiden. *@
        
        <a class="brand" asp-controller="Home" asp-action="Index">CrisisSystem</a>
        
        @* Mobilmeny – vises på mindre skjermer og styres av site.js. *@

        <button class="nav-toggle" type="button" aria-label="Åpne meny"
                aria-expanded="false" aria-controls="main-nav">
            <span aria-hidden="true">☰</span>
        </button>
        
        @* aria-current markerer hvilken side som er aktiv. *@

        <nav id="main-nav" class="main-nav" aria-label="Hovedmeny">
            <a asp-controller="Home" asp-action="Index"
               aria-current="@(IsActive("Home") ? "page" : null)">Hjem</a>
            <a asp-controller="Resource" asp-action="Index"
               aria-current="@(IsActive("Resource") ? "page" : null)">Ressurser</a>
            <a asp-controller="Need" asp-action="Index"
               aria-current="@(IsActive("Need") ? "page" : null)">Behov</a>
            <a asp-controller="Map" asp-action="Index"
               aria-current="@(IsActive("Map") ? "page" : null)">Kart</a>

            @* TODO: Peker på Account/Login når innlogging er på plass *@
            <a class="nav-login" asp-controller="Account" asp-action="Login">Logg inn</a>
        </nav>
    </div>
</header>

@* ---------- 2b. HOVEDINNHOLD ----------
       Området som skifter fra side til side. Styling: .site-main i site.css (bakgrunn med fargeflekker). *@

<main class="site-main">
    
    @* Viser en bekreftelsesmelding når controlleren har satt    TempData["Success"]. *@
    
    @if (TempData["Success"] is string successMessage)
    {
        <div class="container">
            <div class="alert alert-success" role="status">@successMessage</div>
        </div>
    }
    
    @* Her settes innholdet fra den aktuelle viewen inn (Index, Create, Map osv.). *@

    @RenderBody()
</main>

@* ---------- 2c. FOOTER ----------
       Felles footer med lenker til infosidene. *@

<footer class="site-footer">
    <div class="container footer-inner">
        <span class="footer-brand">CrisisSystem</span>
        <nav class="footer-links" aria-label="Bunnmeny">
            <a asp-controller="Info" asp-action="Om">Om</a>
            <a asp-controller="Info" asp-action="Kontakt">Kontakt</a>
            <a asp-controller="Info" asp-action="Hjelp">Hjelp</a>
        </nav>
    </div>
</footer>

@* ---------- 2d. JAVASCRIPT ----------
       Lastes sist så siden vises raskt. site.js styrer mobilmenyen. *@

<script src="~/js/site.js" asp-append-version="true"></script>

@* Plass for ekstra script fra andre views (f.eks. Leaflet-JS og kartkode). Valgfri. *@

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>