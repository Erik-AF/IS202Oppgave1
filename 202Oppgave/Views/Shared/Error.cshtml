@model ErrorViewModel
@{
    ViewData["Title"] = "Noe gikk galt";
}
<div class="container"><div class="error-panel">
    <p class="eyebrow">Vi fikk et problem</p>
    <h1>Det gikk ikke helt som planlagt.</h1>
    <p>Prøv igjen om litt, eller gå tilbake til forsiden.</p>
    @if (Model.ShowRequestId)
    {
        <p class="muted">Referanse ved feilsøking: <code>@Model.RequestId</code></p>
    }
    <a class="btn" asp-controller="Home" asp-action="Index">Til forsiden →</a>
</div></div>
