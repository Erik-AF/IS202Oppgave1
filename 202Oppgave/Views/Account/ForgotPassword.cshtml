@model _202Oppgave.ViewModels.Account.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Glemt passord";
}

<h1>Glemt passord</h1>
<p>Skriv inn e-postadressen som er knyttet til brukeren din.</p>
<form asp-action="ForgotPassword" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label">E-postadresse</label>
        <input asp-for="Email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Be om tilbakestilling</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}