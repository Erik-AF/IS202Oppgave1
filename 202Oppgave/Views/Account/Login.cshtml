@model _202Oppgave.ViewModels.Account.LoginViewModel

@{
    ViewData["Title"] = "Logg inn";
}

<p class="eyebrow">Velkommen tilbake</p><h1>Logg inn</h1><p>Få tilgang til registrering og oppdatering av ressurser og behov.</p>
<form asp-action="Login" method="post" class="col-md-6">
    <input asp-for="ReturnUrl" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label">E-postadresse</label>
        <input asp-for="Email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label">Passord</label>
        <input asp-for="Password" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="RememberMe" class="form-check-input" />
        <label asp-for="RememberMe" class="form-check-label">Husk meg</label>
    </div>
    <button type="submit" class="btn btn-primary">Logg inn</button>
</form>

<p class="mt-3"><a asp-action="ForgotPassword">Glemt passordet?</a></p>

<p>Ny her? <a asp-action="Register">Opprett en bruker →</a></p>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}