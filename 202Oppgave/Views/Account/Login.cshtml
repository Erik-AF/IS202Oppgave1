
@model _202Oppgave.ViewModels.Account.LoginViewModel

@{
    ViewData["Title"] = "Logg inn";
}

<section class="auth-card auth-card--login"
         aria-labelledby="auth-title">

    <div class="auth-heading">
        <p class="auth-eyebrow">LOGG INN</p>
        <h1 id="auth-title">Logg inn</h1>
        <p>Få tilgang til ko/ordinert.</p>
    </div>

    <form asp-controller="Account"
          asp-action="Login"
          method="post">

        <input asp-for="ReturnUrl" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="auth-validation"
             role="alert"></div>

        <div class="auth-field">
            <label asp-for="Email">E-post</label>
            <div class="auth-input-wrap">
                <span class="auth-input-icon" aria-hidden="true">✉</span>
                <input asp-for="Email"
                       type="email"
                       placeholder="Skriv inn e-post"
                       autocomplete="email" />
            </div>
            <span asp-validation-for="Email"
                  class="auth-validation"></span>
        </div>

        <div class="auth-field">
            <label asp-for="Password">Passord</label>
            <div class="auth-input-wrap">
                <span class="auth-input-icon" aria-hidden="true">♙</span>
                <input asp-for="Password"
                       type="password"
                       placeholder="Skriv inn passord"
                       autocomplete="current-password" />
                <button type="button"
                        class="auth-toggle-password"
                        data-password-toggle="Password"
                        aria-label="Vis passord"
                        aria-pressed="false">
                    Vis
                </button>
            </div>
            <span asp-validation-for="Password"
                  class="auth-validation"></span>
        </div>

        <div class="auth-forgot">
            <a asp-controller="Account"
               asp-action="ForgotPassword">
                Har du glemt passordet?
            </a>
        </div>

        <button type="submit" class="auth-submit">
            Logg inn
        </button>
    </form>

    <div class="auth-bottom">
        <span>Har du ikke en bruker?</span>
        <a asp-controller="Account"
           asp-action="Register">Registrer deg</a>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/account-auth.js"
            asp-append-version="true"></script>
}
