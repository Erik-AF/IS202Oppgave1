@model _202Oppgave.ViewModels.ResourceViewModel

@*
    Create.cshtml – registreringsskjema for ressurser.

    Feltnavnene her matcher ResourceViewModel. Latitude/Longitude fylles
    ut av kartet
*@

@{
    ViewData["Title"] = "Rediger ressurs";
}

<div class="container home-content">
    <a class="back-link" asp-action="Index">← Til ressursoversikten</a>
    <p class="eyebrow">Bidra til beredskapen</p>
    <h1>Rediger ressurs</h1>
    <p class="page-intro">Gjør utstyr og kapasitet synlig. Legg inn opplysninger og velg plasseringen på kartet.</p>
    <div class="resource-layout">
        <form asp-action="Edit" asp-route-id="@ViewBag.ResourceId" method="post" enctype="multipart/form-data" class="card" style="padding:2rem; min-width:0;">
            <div asp-validation-summary="ModelOnly" style="color:var(--brick); margin-bottom:1rem;"></div>
            
            @* Kategori. Listen fylles fra databasen av FillCategoryOptionsAsync i controlleren. *@
            <div style="margin-bottom:1rem;">
                <label asp-for="CategoryId"></label>
                <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="form-select">
                    <option value="">Velg kategori</option>
                </select>
                <span asp-validation-for="CategoryId" style="color:var(--brick);"></span>
            </div>

            <div style="margin-bottom:1rem;">
                <label asp-for="Type"></label>
                <input asp-for="Type" class="form-control"/>
                <span asp-validation-for="Type" style="color:var(--brick);"></span>
            </div>

            <div style="margin-bottom:1rem;">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" class="form-control"></textarea>
            </div>

            <div style="margin-bottom:1rem;">
                <label asp-for="Area"></label>
                <input asp-for="Area" class="form-control"/>
                <span asp-validation-for="Area" style="color:var(--brick);"></span>
            </div>

            @* Latitude/Longitude: vanlige tallfelt inntil kartet er koblet på. *@
            <div style="margin-bottom:1rem;">
                <label asp-for="Latitude"></label>
                <input asp-for="Latitude" class="form-control"/>
                <span asp-validation-for="Latitude" style="color:var(--brick);"></span>
            </div>

            <div style="margin-bottom:1rem;">
                <label asp-for="Longitude"></label>
                <input asp-for="Longitude" class="form-control"/>
                <span asp-validation-for="Longitude" style="color:var(--brick);"></span>
            </div>

            <div style="margin-bottom:1rem;">
                <label asp-for="AvailableFrom"></label>
                <input asp-for="AvailableFrom" class="form-control" type="date"/>
            </div>

            <div style="margin-bottom:1rem;">
                <label asp-for="AvailableTo"></label>
                <input asp-for="AvailableTo" class="form-control" type="date"/>
                <span asp-validation-for="AvailableTo" style="color:var(--brick);"></span>
            </div>

            <div style="margin-bottom:1rem;">
                <label asp-for="ContactName"></label>
                <input asp-for="ContactName" class="form-control"/>
                <span asp-validation-for="ContactName" style="color:var(--brick);"></span>
            </div>

            <div style="margin-bottom:1rem;">
                <label asp-for="ContactPhone"></label>
                <input asp-for="ContactPhone" class="form-control"/>
                <span asp-validation-for="ContactPhone" style="color:var(--brick);"></span>
            </div>

            <div style="margin-bottom:1rem;">
                <label asp-for="ContactEmail"></label>
                <input asp-for="ContactEmail" class="form-control"/>
            </div>

            <div style="margin-bottom:1rem;">
                <label asp-for="Status"></label>
                <select asp-for="Status" class="form-select">
                    <option value="Tilgjengelig">Tilgjengelig</option>
                    <option value="Reservert">Reservert</option>
                    <option value="Utilgjengelig">Utilgjengelig</option>
                </select>
            </div>

            <div style="margin-bottom:1.5rem;">
                <label asp-for="OwnerName"></label>
                <input asp-for="OwnerName" class="form-control"/>
            </div>
            
            @* Bilde av ressursen. Velg et nytt for å bytte, ellers beholdes dagens. *@
            <div style="margin-bottom:1.5rem;">
                <label asp-for="Image"></label>

                @* Viser bildet som allerede er lagret *@
                @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
                {
                    <img src="@Model.ImagePath" alt="Dagens bilde"
                         style="display:block; margin-bottom:0.75rem; width:100%; max-width:320px; aspect-ratio:16/10; object-fit:cover;" />
                }

                <input asp-for="Image" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
                <small style="display:block; color:var(--muted);">La stå tomt for å beholde dagens bilde.</small>
                <span asp-validation-for="Image" style="color:var(--brick);"></span>

                <img id="image-preview" alt="" hidden
                     style="display:block; margin-top:0.75rem; width:100%; max-width:320px; aspect-ratio:16/10; object-fit:cover;" />
            </div>

            @* Inline style her fordi .btn i components.css foreløpig mangler
           padding/hvit tekst/avrunding, se melding til Sarah. *@
        <button type="submit" class="btn btn-primary" >Lagre endringer</button>
        </form>
        <div class="resource-map-panel"><h2 class="map-panel-title">Velg plassering</h2><p>Klikk i kartet for å velge hvor ressursen befinner seg.</p>
            <div id="resource-map"></div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Lagret posisjon fra databasen (null hvis ressursen ikke har noen)
        const savedLat = @Json.Serialize(Model.Latitude);
        const savedLng = @Json.Serialize(Model.Longitude);

        // Starter på lagret posisjon, ellers i Kristiansand
        const map = L.map('resource-map')
            .setView(savedLat !== null ? [savedLat, savedLng] : [58.1467, 7.9956], 13);

        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);

        const latitudeInput = document.getElementById('Latitude');
        const longitudeInput = document.getElementById('Longitude');

        // Markør på lagret posisjon
        let marker;
        if (savedLat !== null) {
            marker = L.marker([savedLat, savedLng]).addTo(map);
        }

        // Klikk flytter markøren og oppdaterer feltene
        map.on('click', function (e) {

            // Viser bildet brukeren har valgt før skjemaet sendes
            document.getElementById('Image').addEventListener('change', function () {
                const preview = document.getElementById('image-preview');
                const file = this.files[0];

                if (file) {
                    preview.src = URL.createObjectURL(file);
                    preview.hidden = false;
                }
            });
            latitudeInput.value = e.latlng.lat;
            longitudeInput.value = e.latlng.lng;

            if (marker) {
                marker.setLatLng(e.latlng);
            } else {
                marker = L.marker(e.latlng).addTo(map);
            }
        });
    </script>
}