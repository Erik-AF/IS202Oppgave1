@model _202Oppgave.ViewModels.ResourceViewModel

@*
    Edit.cshtml – redigeringsskjema for ressurser.

    Feltnavnene her matcher ResourceViewModel. Latitude/Longitude fylles
    ut av kartet, og kan ikke skrives inn for hånd.
*@

@{
    ViewData["Title"] = "Rediger ressurs";
}

@section Head {
    <style>
        /* Skjema til venstre og kart til høyre, samme som Registrer ressurs */
        #resource-layout {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 2rem;
            align-items: start;
        }

        /* Sørger for at kartet passer i kolonnen */
        #resource-layout .resource-map-panel {
            min-width: 0;
        }

        /* Kartets størrelse */
        #resource-map {
            height: 550px;
            width: 100%;
            border-radius: 12px;
        }

        /* Små koordinatfelt ved siden av hverandre under kartet */
        .resource-coords {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-top: 0.75rem;
        }

        /* Mindre tekst, så feltene ikke tar fokus fra skjemaet */
        .resource-coords label,
        .resource-coords input {
            font-size: 0.85rem;
        }

        /* Grå bakgrunn viser at feltene ikke kan redigeres.
           Må være mer spesifikk enn .form-control[readonly] i components.css */
        .resource-coords .form-control[readonly] {
            background-color: #edeeec;
            color: var(--muted);
            cursor: default;
        }

        /* Ingen blå fokusramme når man klikker i feltene */
        .resource-coords .form-control[readonly]:focus {
            border-color: var(--line-strong);
            box-shadow: none;
        }

        /* På mobil legges kartet under skjemaet */
        @@media (max-width: 800px) {
            #resource-layout {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="container home-content">
    <a class="back-link" asp-action="Index">← Til ressursoversikten</a>
    <p class="eyebrow">Bidra til beredskapen</p>
    <h1>Rediger ressurs</h1>

    @* Skjemaet omslutter både feltene og kartet, slik at koordinatene under kartet sendes med *@
    <form id="resource-layout"
          class="resource-layout"
          asp-action="Edit"
          asp-route-id="@ViewBag.ResourceId"
          method="post"
          enctype="multipart/form-data">

        @* Venstre kolonne: skjemafeltene *@
        <div class="card" style="padding:2rem; min-width:0;">

            @* Sender kartformen sammen med ressursen. *@
            <input asp-for="GeometryJson" type="hidden" />

            <div asp-validation-summary="ModelOnly" style="color:var(--brick); margin-bottom:1rem;"></div>

            @* Kategori. Listen fylles fra databasen av FillCategoryOptionsAsync i controlleren. *@
            <div style="margin-bottom:1rem;">
                <label asp-for="CategoryId"></label>
                <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="form-select">
                    <option value="">Velg kategori</option>
                </select>
                <span asp-validation-for="CategoryId" style="color:var(--brick);"></span>
            </div>

            <div style="margin-bottom:1rem;">
                <label asp-for="Type"></label>
                <input asp-for="Type" class="form-control"/>
                <span asp-validation-for="Type" style="color:var(--brick);"></span>
            </div>

            <div style="margin-bottom:1rem;">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" class="form-control"></textarea>
            </div>

            <div style="margin-bottom:1rem;">
                <label asp-for="Area"></label>
                <input asp-for="Area" class="form-control"/>
                <span asp-validation-for="Area" style="color:var(--brick);"></span>
            </div>

            <div style="margin-bottom:1rem;">
                <label asp-for="AvailableFrom"></label>
                <input asp-for="AvailableFrom" class="form-control" type="date"/>
            </div>

            <div style="margin-bottom:1rem;">
                <label asp-for="AvailableTo"></label>
                <input asp-for="AvailableTo" class="form-control" type="date"/>
                <span asp-validation-for="AvailableTo" style="color:var(--brick);"></span>
            </div>

            <div style="margin-bottom:1rem;">
                <label asp-for="ContactName"></label>
                <input asp-for="ContactName" class="form-control"/>
                <span asp-validation-for="ContactName" style="color:var(--brick);"></span>
            </div>

            <div style="margin-bottom:1rem;">
                <label asp-for="ContactPhone"></label>
                <input asp-for="ContactPhone" class="form-control"/>
                <span asp-validation-for="ContactPhone" style="color:var(--brick);"></span>
            </div>

            <div style="margin-bottom:1rem;">
                <label asp-for="ContactEmail"></label>
                <input asp-for="ContactEmail" class="form-control"/>
            </div>

            <div style="margin-bottom:1rem;">
                <label asp-for="Status"></label>
                <select asp-for="Status" class="form-select">
                    <option value="Tilgjengelig">Tilgjengelig</option>
                    <option value="Reservert">Reservert</option>
                    <option value="Utilgjengelig">Utilgjengelig</option>
                </select>
            </div>

            <div style="margin-bottom:1.5rem;">
                <label asp-for="OwnerName"></label>
                <input asp-for="OwnerName" class="form-control"/>
            </div>

            @* Bilde av ressursen. Velg et nytt for å bytte, ellers beholdes dagens. *@
            <div style="margin-bottom:1.5rem;">
                <label asp-for="Image"></label>

                @* Viser bildet som allerede er lagret *@
                @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
                {
                    <img src="@Model.ImagePath" alt="Dagens bilde"
                         style="display:block; margin-bottom:0.75rem; width:100%; max-width:320px; aspect-ratio:16/10; object-fit:cover;" />
                }

                <input asp-for="Image" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
                <small style="display:block; color:var(--muted);">La stå tomt for å beholde dagens bilde.</small>
                <span asp-validation-for="Image" style="color:var(--brick);"></span>

                <img id="image-preview" alt="Forhåndsvisning av valgt bilde" hidden
                     style="display:block; margin-top:0.75rem; width:100%; max-width:320px; aspect-ratio:16/10; object-fit:cover;" />
            </div>

            @* Inline style her fordi .btn i components.css foreløpig mangler
               padding/hvit tekst/avrunding, se melding til Sarah. *@
            <button type="submit" class="btn btn-primary" style="color:#fff; padding:0.65rem 1.4rem; border-radius:999px; border:none; cursor:pointer;">Lagre endringer</button>
        </div>

        @* Høyre kolonne: kartet og koordinatene *@
        <div class="resource-map-panel">
            <p>
                Flytt markeringen med redigeringsknappen (blyanten) i kartet,
                eller tegn en ny markering for å erstatte den gamle.
            </p>

            <div id="resource-map"></div>

            @* Koordinatene fylles automatisk fra kartet.
               Feltene er readonly, men sendes likevel med skjemaet. *@
            <div class="resource-coords">
                <div>
                    <label asp-for="Latitude"></label>
                    <input asp-for="Latitude" class="form-control" readonly />
                    <span asp-validation-for="Latitude" style="color:var(--brick);"></span>
                </div>
                <div>
                    <label asp-for="Longitude"></label>
                    <input asp-for="Longitude" class="form-control" readonly />
                    <span asp-validation-for="Longitude" style="color:var(--brick);"></span>
                </div>
            </div>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Forhåndsvisning av valgt bilde, uavhengig av kartet
        const imageInput = document.getElementById('Image');
        const imagePreview = document.getElementById('image-preview');
        let previewUrl = null;
        imageInput.addEventListener('change', function () {
            if (previewUrl) {
                URL.revokeObjectURL(previewUrl);
                previewUrl = null;
            }
            const file = this.files && this.files[0];
            if (file) {
                previewUrl = URL.createObjectURL(file);
                imagePreview.src = previewUrl;
                imagePreview.hidden = false;
            } else {
                imagePreview.removeAttribute('src');
                imagePreview.hidden = true;
            }
        });

        // Opprett kartet (startpunkt i Kristiansand, flyttes til lagret posisjon under)
        const map = L.map('resource-map')
            .setView([58.1467, 7.9956], 13);

        // OpenStreetMap
        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);

        // Gruppe for tegninger. Den lagrede markeringen legges også her,
        // slik at den kan flyttes med redigeringsverktøyet.
        const drawnItems = new L.FeatureGroup();
        map.addLayer(drawnItems);

        // Tilpass linjeverktøyet:
        // Klikk på første punkt for å lukke og avslutte linjen.
        const originalAddVertex = L.Draw.Polyline.prototype.addVertex;

        L.Draw.Polyline.include({
            addVertex: function (latlng) {
                const result = originalAddVertex.call(this, latlng);

                // Når første punkt opprettes, kobles
                // en egen klikkhendelse til denne markøren.
                if (this._markers.length === 1) {
                    const firstMarker = this._markers[0];

                    firstMarker.off('click');

                    firstMarker.on('click', (event) => {
                        // Krev minst tre punkter før figuren lukkes.
                        if (this._markers.length < 3) {
                            return;
                        }

                        if (event.originalEvent) {
                            L.DomEvent.stop(event.originalEvent);
                        }

                        // Legg til startpunktet som siste punkt og avslutt tegningen.
                        originalAddVertex.call(this, this._markers[0].getLatLng());
                        this.completeShape();
                    });
                }

                return result;
            }
        });

        // Leaflet.Draw-verktøy. "edit" gir blyant-knappen som lar brukeren
        // dra markeringen til en ny posisjon.
        const drawControl = new L.Control.Draw({
            draw: {
                polygon: true,
                polyline: true,
                circle: true,
                rectangle: true,
                marker: true,
                circlemarker: false
            },
            edit: {
                featureGroup: drawnItems,
                remove: true
            }
        });

        map.addControl(drawControl);

        // Koordinatfeltene
        const latitudeInput = document.getElementById('Latitude');
        const longitudeInput = document.getElementById('Longitude');

        // Det skjulte feltet for kartformen
        const geometryInput = document.getElementById('GeometryJson');

        // Lagrer formen i det skjulte feltet
        function updateGeometry(layer) {
            const geometry = layer.toGeoJSON();

            // Sirkler trenger også radius for å gjenopprettes
            if (layer instanceof L.Circle) {
                geometry.properties.radius = layer.getRadius();
            }
            geometryInput.value = JSON.stringify(geometry);
        }

        // Oppdater koordinater for alle figurtyper
        function updateCoordinates(layer) {
            updateGeometry(layer);
            let latlng;

            if (layer instanceof L.Marker ||
                layer instanceof L.Circle) {

                latlng = layer.getLatLng();

            } else if (typeof layer.getBounds === 'function') {

                // For områder brukes midtpunktet
                latlng = layer.getBounds().getCenter();
            }

            if (latlng) {
                latitudeInput.value = latlng.lat.toFixed(6);
                longitudeInput.value = latlng.lng.toFixed(6);
            }
        }

        // Vis lagret markering når siden åpnes:
        // 1) Lagret form (GeometryJson) hvis den finnes
        // 2) Ellers en markør på lagret breddegrad/lengdegrad (eldre ressurser)
        let geometry = null;
        if (geometryInput.value) {
            try {
                geometry = JSON.parse(geometryInput.value);
            } catch (error) {
                console.warn('Ugyldig GeometryJson:', error);
            }
        }

        if (geometry) {
            const restored = L.geoJSON(geometry, {
                pointToLayer: function (feature, latlng) {
                    const radius = feature.properties?.radius;

                    if (typeof radius === 'number' && radius > 0) {
                        return L.circle(latlng, { radius: radius });
                    }

                    return L.marker(latlng);
                }
            });

            restored.eachLayer(function (layer) {
                drawnItems.addLayer(layer);
            });

            map.fitBounds(drawnItems.getBounds(), {
                padding: [20, 20],
                maxZoom: 15
            });
        }
        else if (latitudeInput.value && longitudeInput.value) {
            const lat = Number(latitudeInput.value.replace(',', '.'));
            const lng = Number(longitudeInput.value.replace(',', '.'));

            if (Number.isFinite(lat) && Number.isFinite(lng)) {
                drawnItems.addLayer(L.marker([lat, lng]));
                map.setView([lat, lng], 13);
            }
        }

        // Ny markering erstatter den gamle
        map.on('draw:created', function (e) {
            drawnItems.clearLayers();

            const layer = e.layer;
            drawnItems.addLayer(layer);

            updateCoordinates(layer);
        });

        // Markeringen er flyttet eller endret med blyant-knappen
        map.on('draw:edited', function (e) {
            e.layers.eachLayer(function (layer) {
                updateCoordinates(layer);
            });
        });

        // Markeringen er slettet
        map.on('draw:deleted', function () {
            latitudeInput.value = '';
            longitudeInput.value = '';
            geometryInput.value = '';
        });

        // Oppdater kartstørrelsen
        setTimeout(function () {
            map.invalidateSize();
        }, 100);
    </script>
}
