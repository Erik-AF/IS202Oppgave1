@model _202Oppgave.Models.Resource

@*
    Details.cshtml – detaljvisning for én registrert ressurs.
*@

@{
    ViewData["Title"] = "Ressursdetaljer";

    // Samme fargelogikk som i Index.cshtml, se kommentar der.
    var statusColor = Model.Status switch
    {
        "Tilgjengelig" => "var(--map-available)",
        "Reservert" => "var(--map-planned)",
        _ => "var(--muted)"
    };
}

<div class="container home-content">
    <a class="back-link" asp-action="Index">← Til oversikten</a><div class="card detail-card">
        
        @* Opplastet bilde. Vises bare hvis ressursen har et. *@
        @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
        {
            <img src="@Model.ImagePath" alt="Bilde av @Model.Type"
                 style="display:block; width:100%; aspect-ratio:16/10; object-fit:cover; margin-bottom:1.25rem;" />
        }
        
        <p class="eyebrow">Ressursdetaljer</p><h1>@Model.Type</h1>
        <p><strong>Kategori:</strong> @(Model.CategoryName ?? "Ikke satt")</p>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p><strong>Beskrivelse:</strong> @Model.Description</p>
        }
        <p><strong>Status:</strong> <span style="color:@statusColor; font-weight:600;">@Model.Status</span></p>
        <p><strong>Kontakt:</strong> @Model.ContactName, @Model.ContactPhone</p>
        
        @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
        {
            <div id="details-map" style="height:350px; width:100%;"></div>
        }
        else
        {
            <p>Ingen kartposisjon er lagret for denne ressursen.</p>
        }
        <div class="detail-actions"><p><a asp-action="Index" class="btn btn-primary" style="color:#fff; text-decoration:none; display:inline-block; padding:0.65rem 1.4rem; border-radius:999px;">Tilbake</a></p>
        <p><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary" style="color:#fff; 
        text-decoration:none; display:inline-block; padding:0.65rem 1.4rem; border-radius:999px;">Rediger</a></p>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
              
              onsubmit="return confirm('Er du sikker på at du vil slette denne ressursen?');"
              style="display:inline;">
            <button type="submit"
                    class="btn"
                    style="background:#b42318; color:#fff; padding:0.65rem 1.4rem; border-radius:999px; border:none; cursor:pointer;">
                Slett
            </button>
        </form>
    </div>
    </div>
</div>
@section Scripts {
    @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
    {
        <script>
            const position = [
                @Json.Serialize(Model.Latitude),
                @Json.Serialize(Model.Longitude)
            ];

            const map = L.map('details-map').setView(position, 15);

            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(map);

            // Henter den lagrede kartformen fra modellen.
            const geometryJson = @Json.Serialize(Model.GeometryJson);

            if (geometryJson) {
                const geometry = JSON.parse(geometryJson);

                const shape = L.geoJSON(geometry, {
                    pointToLayer: function (feature, latlng) {
                        const radius = feature.properties?.radius;

                        if (typeof radius === 'number' && radius > 0) {
                            return L.circle(latlng, {
                                radius: radius
                            });
                        }

                        return L.marker(latlng);
                    }
                }).addTo(map);

                // Tilpasser kartet slik at hele formen vises.
                map.fitBounds(shape.getBounds(), {
                    padding: [20, 20],
                    maxZoom: 15
                });
            } else {
                // Eldre ressurser uten formdata vises som markører.
                L.marker(position).addTo(map);
            }        </script>
    }
}