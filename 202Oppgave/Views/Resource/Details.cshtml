@model _202Oppgave.Models.Resource

@*
    Details.cshtml – detaljvisning for én registrert ressurs.
*@

@{
    ViewData["Title"] = "Ressursdetaljer";

    // Samme fargelogikk som i Index.cshtml, se kommentar der.
    var statusColor = Model.Status switch
    {
        "Tilgjengelig" => "var(--map-available)",
        "Reservert" => "var(--map-planned)",
        _ => "var(--muted)"
    };
}

@section Head {
    <style>
    /* Bildet øverst i kortet, med runde hjørner som kartet */
    .rd-image {
        display: block;
        width: 100%;
        max-width: 520px;
        aspect-ratio: 16 / 10;
        object-fit: cover;
        border-radius: 12px;
        margin-bottom: 24px;
    }

    /* Statusen i fet skrift. Fargen settes per ressurs i HTML */
    .rd-status {
        font-weight: 700;
    }

    /* Kartet: høyde, kant og runde hjørner, som på behovsdetaljene */
    #details-map {
        height: 350px;
        width: 100%;
        margin: 24px 0;
        border: 1px solid #dbe1d8;
        border-radius: 12px;
    }
    </style>
}

@* need-design og need-details gir samme stil som detaljsiden for behov (fra need.css) *@
<div class="container home-content need-design need-details">

    @* Brødsmulesti: Hjem / Ressurser / navnet på ressursen *@
    <nav class="need-breadcrumb" aria-label="Brødsmuler">
        <a asp-controller="Home" asp-action="Index">Hjem</a>
        <span aria-hidden="true">/</span>
        <a asp-action="Index">Ressurser</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">@Model.Type</span>
    </nav>

    <div class="card detail-card">

        @* Opplastet bilde. Vises bare hvis ressursen har et. *@
        @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
        {
            <img src="@Model.ImagePath" alt="Bilde av @Model.Type" class="rd-image" />
        }

        <p class="eyebrow">Ressursdetaljer</p>
        <h1>@Model.Type</h1>

        <p><strong>Kategori:</strong> @(Model.CategoryName ?? "Ikke satt")</p>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p><strong>Beskrivelse:</strong> @Model.Description</p>
        }
        <p><strong>Adresse eller sted:</strong> @Model.Area</p>
        <p><strong>Status:</strong> <span class="rd-status" style="color:@statusColor;">@Model.Status</span></p>

        @* Kontaktinfo fra brukeren som registrerte ressursen *@
        <p><strong>Registrert av:</strong> @(string.IsNullOrWhiteSpace(Model.ContactName) ? "Ukjent" : Model.ContactName)</p>
        @if (!string.IsNullOrWhiteSpace(Model.ContactPhone))
        {
            <p><strong>Telefon:</strong> <a href="tel:@Model.ContactPhone">@Model.ContactPhone</a></p>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ContactEmail))
        {
            <p><strong>E-post:</strong> <a href="mailto:@Model.ContactEmail">@Model.ContactEmail</a></p>
        }

        @* Kartet får høyde, kant og runde hjørner fra need.css (.need-details #details-map) *@
        @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
        {
            <div id="details-map"></div>
        }
        else
        {
            <p>Ingen kartposisjon er lagret for denne ressursen.</p>
        }

        @* Knappene får samme stil som på behovssiden (fra need.css) *@
        <div class="detail-actions">
            <p><a asp-action="Index" class="btn btn-primary">Se alle ressurser</a></p>
            @* Bare den som registrerte ressursen kan redigere den *@
            @if (Model.CanEdit)
            {
                <p><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Rediger</a></p>
            }

            @* Eieren og admin kan slette.
               Ber om bekreftelse for å unngå at en ressurs slettes ved et uhell *@
            @if (Model.CanDelete)
            {
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Er du sikker på at du vil slette denne ressursen?');">
                    <button type="submit" class="btn need-delete-button">Slett</button>
                </form>
            }
        </div>
    </div>
</div>
@section Scripts {
    @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
    {
        <script>
            const position = [
                @Json.Serialize(Model.Latitude),
                @Json.Serialize(Model.Longitude)
            ];

            const map = L.map('details-map').setView(position, 15);

            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(map);

            // Henter den lagrede kartformen fra modellen.
            const geometryJson = @Json.Serialize(Model.GeometryJson);

            if (geometryJson) {
                const geometry = JSON.parse(geometryJson);

                const shape = L.geoJSON(geometry, {
                    pointToLayer: function (feature, latlng) {
                        const radius = feature.properties?.radius;

                        if (typeof radius === 'number' && radius > 0) {
                            return L.circle(latlng, {
                                radius: radius
                            });
                        }

                        return L.marker(latlng);
                    }
                }).addTo(map);

                // Tilpasser kartet slik at hele formen vises.
                map.fitBounds(shape.getBounds(), {
                    padding: [20, 20],
                    maxZoom: 15
                });
            } else {
                // Eldre ressurser uten formdata vises som markører.
                L.marker(position).addTo(map);
            }        </script>
    }
}