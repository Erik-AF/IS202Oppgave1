@model _202Oppgave.Models.Resource

@{
    ViewData["Title"] = "Ressursdetaljer";
    var statusColor = Model.Status switch
    {
        "Tilgjengelig" => "var(--map-available)",
        "Reservert" => "var(--map-planned)",
        _ => "var(--muted)"
    };
}

<div class="container home-content">
    <div class="card" style="padding:2rem; max-width:600px;">
        <h1>@Model.Type</h1>
        <p><strong>Område:</strong> @Model.Area</p>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p><strong>Beskrivelse:</strong> @Model.Description</p>
        }
        <p><strong>Status:</strong> <span style="color:@statusColor; font-weight:600;">@Model.Status</span></p>
        <p><strong>Kontakt:</strong> @Model.ContactName, @Model.ContactPhone</p>
        
        @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
        {
            <div id="details-map" style="height:350px; width:100%;"></div>
        }
        else
        {
            <p>Ingen kartposisjon er lagret for denne ressursen.</p>
        }
        <p style="margin-top:1rem;">
            <a asp-action="Index"
               class="btn btn-primary"
               style="color:#fff; text-decoration:none; display:inline-block; padding:0.65rem 1.4rem; border-radius:999px;">
                Tilbake
            </a>
        </p>
    </div>
</div>
@section Scripts {
    @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
    {
        <script>
            const position = [
                @Json.Serialize(Model.Latitude),
                @Json.Serialize(Model.Longitude)
            ];

            const map = L.map('details-map').setView(position, 15);

            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(map);

            L.marker(position).addTo(map);
        </script>
    }
}




















