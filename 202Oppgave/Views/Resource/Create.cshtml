
@model _202Oppgave.ViewModels.ResourceViewModel

@{
    ViewData["Title"] = "Registrer ressurs";
}

@section Head {
    <style>
        #resource-layout {
            --brick: #b41818;
        }
        /* Skjema til venstre og kart til høyre */
        #resource-layout {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 2rem;
            align-items: start;
        }

        /* Sørger for at kartet passer i kolonnen */
        #resource-layout .resource-map-panel {
            min-width: 0;
        }

        /* Kartets størrelse */
        #resource-map {
            height: 550px;
            width: 100%;
            border-radius: 12px;
        }

        /* Små koordinatfelt ved siden av hverandre under kartet */
        .resource-coords {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-top: 0.75rem;
        }

        /* Mindre tekst, så feltene ikke tar fokus fra skjemaet */
        .resource-coords label,
        .resource-coords input {
            font-size: 0.85rem;
        }

        /* Grå bakgrunn viser at feltene ikke kan redigeres.
   Må være mer spesifikk enn .form-control[readonly] i components.css */
        .resource-coords .form-control[readonly] {
            background-color: #edeeec;
            color: var(--muted);
            cursor: default;
        }

        /* Ingen blå fokusramme når man klikker i feltene */
        .resource-coords .form-control[readonly]:focus {
            border-color: var(--line-strong);
            box-shadow: none;
        }



        /* På mobil legges kartet under skjemaet */
        @@media (max-width: 800px) {
            #resource-layout {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="container home-content">
    <h1>Registrer ressurs</h1>

    @* Skjemaet omslutter både feltene og kartet, slik at koordinatene under kartet sendes med *@
    <form id="resource-layout"
          class="resource-layout"
          asp-controller="Resource"
          asp-action="Create"
          method="post"
          enctype="multipart/form-data">

    @* Venstre kolonne: skjemafeltene *@
    <div class="card" style="padding:2rem; min-width:0;">

    @* Sender kartformen sammen med ressursern. *@
    <input asp-for="GeometryJson" type="hidden" />

    <div asp-validation-summary="ModelOnly"
         style="color:#b42318; margin-bottom:1rem;">
    </div>

    @* Kategorier fra databasen *@
    <div style="margin-bottom:1rem;">
        <label asp-for="CategoryId"></label>
        <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="form-select">
            <option value="">Velg kategori</option>
        </select>
        <span asp-validation-for="CategoryId" style="color:#b42318;"></span>
    </div>

    <div style="margin-bottom:1rem;">
        <label asp-for="Type"></label>
        <input asp-for="Type" class="form-control"/>
        <span asp-validation-for="Type"
              style="color:#b42318;"></span>
    </div>

    <div style="margin-bottom:1rem;">
        <label asp-for="Description"></label>
        <textarea asp-for="Description"
                          class="form-control"></textarea>
        <span asp-validation-for="Description"
              style="color:#b42318;"></span>
    </div>

    <div style="margin-bottom:1rem;">
        <label asp-for="Area"></label>
        <input asp-for="Area" class="form-control"/>
        <span asp-validation-for="Area"
              style="color:#b42318;"></span>
    </div>
    

    <div style="margin-bottom:1rem;">
        <label asp-for="AvailableFrom"></label>
        <input asp-for="AvailableFrom"
               class="form-control"
               type="date"/>
    </div>

    <div style="margin-bottom:1rem;">
        <label asp-for="AvailableTo"></label>
        <input asp-for="AvailableTo"
               class="form-control"
               type="date"/>
    </div>

    <div style="margin-bottom:1rem;">
        <label asp-for="ContactName"></label>
        <input asp-for="ContactName"
               class="form-control"/>
        <span asp-validation-for="ContactName"
              style="color:#b42318;"></span>
    </div>

    <div style="margin-bottom:1rem;">
        <label asp-for="ContactPhone"></label>
        <input asp-for="ContactPhone"
               class="form-control"/>
        <span asp-validation-for="ContactPhone"
              style="color:#b42318;"></span>
    </div>

    <div style="margin-bottom:1rem;">
        <label asp-for="ContactEmail"></label>
        <input asp-for="ContactEmail"
               class="form-control"/>
    </div>

    <div style="margin-bottom:1rem;">
        <label asp-for="Status"></label>
        <select asp-for="Status" class="form-select">
            <option value="Tilgjengelig">Tilgjengelig</option>
            <option value="Reservert">Reservert</option>
            <option value="Utilgjengelig">Utilgjengelig</option>
        </select>
    </div>

    <div style="margin-bottom:1.5rem;">
        <label asp-for="OwnerName"></label>
        <input asp-for="OwnerName"
               class="form-control"/>
    </div>

    @* Valgfritt ressursbilde *@
    <div style="margin-bottom:1.5rem;">
        <label asp-for="Image"></label>
        <input asp-for="Image" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
        <small style="display:block; color:var(--muted);">JPG, PNG eller WEBP.</small>
        <span asp-validation-for="Image" style="color:#b42318;"></span>
        <img id="image-preview" alt="Forhåndsvisning av valgt bilde" hidden
             style="margin-top:0.75rem; width:100%; max-width:320px; aspect-ratio:16/10; object-fit:cover;" />
    </div>

    <button type="submit"
            class="btn btn-primary"
            style="color:#fff; padding:0.65rem 1.4rem; border-radius:999px; border:none; cursor:pointer;">
        Registrer
    </button>

</div>

<div class="resource-map-panel">
    <p>
        Velg en posisjon eller tegn et område på kartet.
        Kun én markering kan registreres om gangen.
    </p>

    <div id="resource-map"></div>
    
    @* Koordinatene fylles automatisk når man markerer i kartet.
   Feltene er readonly, men sendes likevel med skjemaet. *@
    <div class="resource-coords">
        <div>
            <label asp-for="Latitude"></label>
            <input asp-for="Latitude" class="form-control" readonly />
            <span asp-validation-for="Latitude" style="color:#b42318;"></span>
        </div>
        <div>
            <label asp-for="Longitude"></label>
            <input asp-for="Longitude" class="form-control" readonly />
            <span asp-validation-for="Longitude" style="color:#b42318;"></span>
        </div>
    </div>

    
</div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Forhåndsvisning av valgt bilde, uavhengig av kartet
        const imageInput = document.getElementById('Image');
        const imagePreview = document.getElementById('image-preview');
        let previewUrl = null;
        imageInput.addEventListener('change', function () {
            if (previewUrl) {
                URL.revokeObjectURL(previewUrl);
                previewUrl = null;
            }
            const file = this.files && this.files[0];
            if (file) {
                previewUrl = URL.createObjectURL(file);
                imagePreview.src = previewUrl;
                imagePreview.hidden = false;
            } else {
                imagePreview.removeAttribute('src');
                imagePreview.hidden = true;
            }
        });

        // Opprett kartet
        const map = L.map('resource-map')
            .setView([58.1467, 7.9956], 13);

        // OpenStreetMap
        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);

        // Gruppe for tegninger
        const drawnItems = new L.FeatureGroup();
        map.addLayer(drawnItems);

        // Tilpass linjeverktøyet:
        // Klikk på første punkt for å lukke og avslutte linjen.
        const originalAddVertex = L.Draw.Polyline.prototype.addVertex;

        L.Draw.Polyline.include({
            addVertex: function (latlng) {
                const result = originalAddVertex.call(this, latlng);

                // Når første punkt opprettes, kobles
                // en egen klikkhendelse til denne markøren.
                if (this._markers.length === 1) {
                    const firstMarker = this._markers[0];

                    firstMarker.off('click');

                    firstMarker.on('click', (event) => {
                        // Krev minst tre punkter før figuren lukkes.
                        if (this._markers.length < 3) {
                            return;
                        }

                        if (event.originalEvent) {
                            L.DomEvent.stop(event.originalEvent);
                        }

                        // Hent startpunktets koordinater.
                        const firstPoint =
                            this._markers[0].getLatLng();

                        // Legg til startpunktet som siste punkt.
                        // Dette tegner den siste linjestrekningen.
                        originalAddVertex.call(this, firstPoint);

                        // Avslutt tegningen.
                        this.completeShape();
                    });
                }

                return result;
            }
        });

        // Leaflet.Draw-verktøy
        const drawControl = new L.Control.Draw({
            draw: {
                polygon: true,
                polyline: true,
                circle: true,
                rectangle: true,
                marker: true,
                circlemarker: false
            },
            edit: {
                featureGroup: drawnItems,
                remove: true
            }
        });

        map.addControl(drawControl);

        // Koordinatfeltene
        const latitudeInput =
            document.getElementById('Latitude');

        const longitudeInput =
            document.getElementById('Longitude');
        
        // Henter det skjulte feltet for kartformen
        const geometryInput = document.getElementById('GeometryJson');

        // Lagrer koordinater for alle figurtyper
        function updateGeometry(layer){
            const geometry = layer.toGeoJSON();
            
            // Sirkler trenger også radous for å gjennopprettes
            if (layer instanceof L.Circle){
                geometry.properties.radius = layer.getRadius();
            }
            geometryInput.value = JSON.stringify(geometry);
        }
        
        // Oppdater koordinater for alle figurtyper
        function updateCoordinates(layer) {
            updateGeometry(layer);
            let latlng;

            if (layer instanceof L.Marker ||
                layer instanceof L.Circle) {

                latlng = layer.getLatLng();

            } else if (typeof layer.getBounds === 'function') {

                latlng = layer.getBounds().getCenter();
            }

            if (latlng) {
                latitudeInput.value = latlng.lat.toFixed(6);
                longitudeInput.value = latlng.lng.toFixed(6);
            }
        }

        // Gjenopprett markør etter skjemafeil
        if (geometryInput.value) {
            let geometry = null;
            try {
                geometry = JSON.parse(geometryInput.value);
            } catch (error) {
                console.warn('Ugyldig GeometryJson:', error);
            }

            if (geometry) {
            const restored = L.geoJSON(geometry, {
                pointToLayer: function (feature, latlng) {
                    const radius = feature.properties?.radius;

                    if (typeof radius === 'number' && radius > 0) {
                        return L.circle(latlng, { radius: radius });
                    }

                    return L.marker(latlng);
                }
            });

            restored.eachLayer(function (layer) {
                drawnItems.addLayer(layer);
            });

            map.fitBounds(drawnItems.getBounds(), {
                padding: [20, 20],
                maxZoom: 15
            });
            }
        }
        else if (latitudeInput.value && longitudeInput.value) {
            const lat = Number(
                latitudeInput.value.replace(',', '.')
            );

            const lng = Number(
                longitudeInput.value.replace(',', '.')
            );

            if (Number.isFinite(lat) && Number.isFinite(lng)) {
                const existingMarker = L.marker([lat, lng]);

                drawnItems.addLayer(existingMarker);
                map.setView([lat, lng], 13);
            }
        }

        // Når en ny markering opprettes
        map.on('draw:created', function (e) {

            // Fjern den gamle markeringen
            drawnItems.clearLayers();

            // Legg til den nye markeringen
            const layer = e.layer;
            drawnItems.addLayer(layer);

            // Oppdater koordinatene
            updateCoordinates(layer);
        });

        // Når markeringen redigeres
        map.on('draw:edited', function (e) {
            e.layers.eachLayer(function (layer) {
                updateCoordinates(layer);
            });
        });

        // Når markeringen slettes
        map.on('draw:deleted', function () {
            latitudeInput.value = '';
            longitudeInput.value = '';
            geometryInput.value = '';
        });

        // Oppdater kartstørrelsen
        setTimeout(function () {
            map.invalidateSize();
        }, 100);
    </script>
}

