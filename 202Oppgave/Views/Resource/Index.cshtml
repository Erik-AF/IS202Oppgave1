@model _202Oppgave.ViewModels.ResourceIndexViewModel

@*
    Index.cshtml – oversikt over alle registrerte ressurser.
    Filtreringen skjer i ResourceController.Index (GET).
    Skjemaet sender valgene i adressen, f.eks. /Resource?type=Traktor
*@

@{
    ViewData["Title"] = "Ressurser";

    // Standardbilde ut fra typen, når ressursen ikke har eget bilde
    string ImageFor(string? type)
    {
        var t = (type ?? "").ToLowerInvariant();
        if (t.Contains("helikopter")) return "~/images/ressurser/helikopter.jpg";
        if (t.Contains("ambulanse")) return "~/images/ressurser/ambulanse.jpg";
        if (t.Contains("aggregat") || t.Contains("strøm")) return "~/images/ressurser/aggregat.jpg";
        if (t.Contains("båt")) return "~/images/ressurser/bat.jpg";
        return "~/images/ressurser/standard.jpg";
    }

    // Klasse for fargeprikken. Samme farger som kartet til Marius.
    string DotClass(string? status) => status switch
    {
        "Tilgjengelig" => "rl-dot--green",
        "Reservert" => "rl-dot--yellow",
        _ => "rl-dot--grey"
    };

    // Bare admin kan velge ressurser og allokere dem til et behov
    var isAdmin = User.IsInRole(_202Oppgave.Models.Authorization.RoleNames.Admin);
}



 
<div class="container rl">

    @* ===== Topp: tittel og knapp ===== *@
    <div class="rl-head">
        <div>
            <p class="eyebrow">Det vi har å bidra med</p><h1>Tilgjengelige ressurser</h1>
            <p>Kjøretøy, maskiner, utstyr og mannskap som kan brukes i en krise.</p>
        </div>
        <a class="rl-btn" asp-action="Create">Registrer ressurs <span aria-hidden="true">→</span></a>
    </div>

    <div class="rl-layout">

        @* ===== Filter =====
           method="get": valgene sendes i adressen til Index i controlleren.
           Ingen antiforgery-token trengs, fordi GET ikke endrer noe. *@
        <form class="rl-filter" asp-action="Index" method="get">
            <h2>Filtrer</h2>

            <label for="q" class="rl-label">Søk</label>
            <input id="q" name="q" value="@Model.Q" class="rl-input" placeholder="Søk i ressurser" />

            <label for="category" class="rl-label">Kategori</label>
            <select id="category" name="category" class="rl-input">
                <option value="">Alle kategorier</option>
                @foreach (var c in Model.CategoryOptions)
                {
                    <option value="@c" selected="@(c == Model.Category)">@c</option>
                }
            </select>

            <label for="status" class="rl-label">Status</label>
            <select id="status" name="status" class="rl-input">
                <option value="">Alle statuser</option>
                @foreach (var s in Model.StatusOptions)
                {
                    <option value="@s" selected="@(s == Model.Status)">@s</option>
                }
            </select>

            <label for="area" class="rl-label">Sted</label>
            <select id="area" name="area" class="rl-input">
                <option value="">Alle steder</option>
                @foreach (var a in Model.AreaOptions)
                {
                    <option value="@a" selected="@(a == Model.Area)">@a</option>
                }
            </select>

            <label for="sort" class="rl-label">Sorter</label>
            <select id="sort" name="sort" class="rl-input">
                <option value="" selected="@(string.IsNullOrEmpty(Model.Sort))">Nyeste først</option>
                <option value="category" selected="@(Model.Sort == "category")">Kategori A–Å</option>
                <option value="area" selected="@(Model.Sort == "area")">Sted A–Å</option>
            </select>

            <button type="submit" class="rl-btn rl-btn--full">Filtrer</button>
            <a asp-action="Index" class="rl-reset">Nullstill filter</a>
        </form>

                @* ===== Listen =====
           Én rad per ressurs: bilde, tekst, status og lenke til Details. *@
        <section>
            <div class="rl-toolbar">
                <p class="rl-found">@Model.Resources.Count ressurser funnet</p>
                @if (isAdmin && Model.Resources.Any())
                {
                    @* Aktiveres av skriptet nederst når minst én ressurs er valgt *@
                    <button type="button" class="rl-btn" id="allocate-open" disabled>
                        Alloker valgte (<span data-allocate-count>0</span>)
                    </button>
                }
            </div>

            @if (!Model.Resources.Any())
            {
                @* Ingen treff, eller ingen ressurser i det hele tatt *@
                <div class="rl-empty">
                    <h3>Ingen ressurser funnet</h3>
                    <p>Prøv et annet filter, eller registrer en ny ressurs.</p>
                </div>
            }
            else
            {
                <ul class="rl-list">
                    @foreach (var r in Model.Resources)
                    {
                        <li class="@(isAdmin ? "rl-pick" : null)">
                            @if (isAdmin)
                            {
                                @* Avkrysningsboksen ligger utenfor lenken, ellers åpner klikket detaljsiden.
                                   form="allocate-form" kobler den til skjemaet i dialogen under. *@
                                <label class="rl-check">
                                    <input type="checkbox" name="resourceIds" value="@r.Id" form="allocate-form" data-allocate-check />
                                    <span class="visually-hidden">Velg @r.Type</span>
                                </label>
                            }
                            @* hele raden er en lenke til detaljsiden *@
                            <a class="rl-row" asp-action="Details" asp-route-id="@r.Id">

                                @* eget bilde hvis det finnes, ellers standardbilde ut fra typen *@
                                <img class="rl-img" src="@Url.Content(r.ImagePath ?? ImageFor($"{r.CategoryName} {r.Type}"))" alt="" loading="lazy" />

                                <div>
                                    <h3>@r.Type</h3>
                                    @if (!string.IsNullOrWhiteSpace(r.CategoryName))
                                    {
                                        <p class="rl-cat">@r.CategoryName</p>
                                    }
                                    <ul class="rl-meta">
                                        @if (!string.IsNullOrWhiteSpace(r.OwnerName))
                                        {
                                            <li>@r.OwnerName</li>
                                        }
                                        <li>@r.Area</li>
                                        @if (r.NeedName != null)
                                        {
                                            <li class="rl-allocated">Allokert til: @r.NeedName</li>
                                        }
                                        @if (r.AvailableFrom != null || r.AvailableTo != null)
                                        {
                                            <li>@(r.AvailableFrom?.ToString("dd.MM.yyyy") ?? "nå") – @(r.AvailableTo?.ToString("dd.MM.yyyy") ?? "ubestemt")</li>
                                        }
                                    </ul>
                                </div>

                                <div class="rl-side">
                                    <span class="rl-status">
                                        <span class="rl-dot @DotClass(r.Status)" aria-hidden="true"></span>@r.Status
                                    </span>
                                    <span class="rl-more">Se detaljer <span aria-hidden="true">→</span></span>
                                </div>
                            </a>
                        </li>
                    }
                </ul>
            }
        </section>
    </div>
</div>

@if (isAdmin)
{
    @* ===== Allokering =====
       Dialogen åpnes med «Alloker valgte». Avkrysningsboksene i listen
       sendes med skjemaet via form-attributtet. *@
    <dialog class="rl-dialog" id="allocate-dialog" aria-labelledby="allocate-title">
        <form id="allocate-form" asp-action="Allocate" method="post">
            <h2 id="allocate-title">Alloker ressurser</h2>

            @if (Model.NeedOptions.Any())
            {
                <p><span data-allocate-count>0</span> valgte ressurser tildeles behovet du velger, og får status «Reservert». Ressurser som allerede er allokert, flyttes til det nye behovet.</p>

                <label for="needId" class="rl-label">Behov</label>
                <select id="needId" name="needId" class="rl-input" required>
                    <option value="">Velg behov</option>
                    @foreach (var n in Model.NeedOptions)
                    {
                        <option value="@n.Value">@n.Text</option>
                    }
                </select>
            }
            else
            {
                <p>Det er ingen registrerte behov å allokere til ennå.</p>
            }

            <div class="rl-dialog-actions">
                <button type="button" class="rl-reset" id="allocate-cancel">Avbryt</button>
                <button type="submit" class="rl-btn" disabled="@(!Model.NeedOptions.Any())">Alloker</button>
            </div>
        </form>
    </dialog>
}

@* Skriptet gjør ingenting hvis dialogen ikke finnes (ikke admin) *@
@section Scripts {
    <script>
        (() => {
            const dialog = document.getElementById('allocate-dialog');
            const openButton = document.getElementById('allocate-open');
            if (!dialog || !openButton) return;

            const checks = document.querySelectorAll('[data-allocate-check]');
            const counters = document.querySelectorAll('[data-allocate-count]');

            // Oppdaterer antall valgte, og slår knappen av/på
            const update = () => {
                const selected = [...checks].filter(c => c.checked).length;
                counters.forEach(el => el.textContent = selected);
                openButton.disabled = selected === 0;
            };

            checks.forEach(c => c.addEventListener('change', update));
            openButton.addEventListener('click', () => dialog.showModal());
            document.getElementById('allocate-cancel').addEventListener('click', () => dialog.close());

            // Nettleseren kan huske avkryssinger når man går tilbake til siden
            update();
        })();
    </script>
}
