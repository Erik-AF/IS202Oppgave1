@model _202Oppgave.ViewModels.NeedAllocationViewModel
@{
    ViewData["Title"] = "Alloker ressurser til behov";
}
@section Head {
    <link rel="stylesheet" href="~/css/allocation-suggestions.css" asp-append-version="true" />
}
<div class="container home-content need-design allocation-suggestions">
    <nav class="need-breadcrumb" aria-label="Brødsmuler">
        <a asp-controller="Need" asp-action="Index">Behov</a><span aria-hidden="true">/</span>
        <a asp-controller="Need" asp-action="Confirmation" asp-route-id="@Model.NeedId">@Model.NeedTitle</a>
        <span aria-hidden="true">/</span><span aria-current="page">Alloker ressurser</span>
    </nav>
    <h1>Alloker ressurser</h1>
    <p class="page-intro">Til behovet <strong>@Model.NeedTitle</strong> – @Model.Location</p>
    <section class="suggestions-card">
        <h2>Foreslåtte ressurser</h2>

        <form asp-action="FromNeed" method="post">
            <input asp-for="NeedId" type="hidden" />
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            @if (Model.Suggestions.Count == 0)
            {
                <p class="suggestions-empty" role="status">Ingen tilgjengelige ressurser i nærheten</p>
            }
            else
            {
                <fieldset class="suggestions-options">
                    <legend>Velg ressursene som passer behovet</legend>
                    @foreach (var resource in Model.Suggestions)
                    {
                        <label class="suggestion-option">
                            <input type="checkbox" name="ResourceIds" value="@resource.Id" checked="@(Model.ResourceIds.Contains(resource.Id))" />
                            <span><strong>@resource.Title</strong><span class="suggestion-meta">@resource.Category · @resource.Location</span></span>
                            <span class="suggestion-distance">@resource.DistanceKm.ToString("0.00", System.Globalization.CultureInfo.GetCultureInfo("nb-NO")) km</span>
                        </label>
                    }
                </fieldset>
                <label asp-for="Note">Merknad (valgfritt)</label>
                <textarea asp-for="Note" class="form-control" rows="3" maxlength="500"></textarea>
                <span asp-validation-for="Note" class="text-danger"></span>
            }
            <div class="suggestions-actions">
                <a asp-controller="Need" asp-action="Confirmation" asp-route-id="@Model.NeedId">Tilbake til behovet</a>
                @if (Model.Suggestions.Count > 0)
                {
                    <button type="submit" class="btn btn-primary">Alloker valgte ressurser →</button>
                }
            </div>
        </form>
    </section>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
