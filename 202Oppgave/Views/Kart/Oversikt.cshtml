@{
    ViewData["Title"] = "Kartoversikt";
}
<div class="map-frame">
    <div id="map"></div>
    <aside class="map-panel">
        <h2>Kartlag</h2>
        <p class="map-panel-heading">VIS PÅ KARTET</p>

        <label class="map-layer-row">
            <input type="checkbox" id="show-resources" checked />
            <span>
                <strong>Ressurser</strong>
                <small>Registrerte ressurser</small>
            </span>
        </label>

        <label class="map-layer-row">
            <input type="checkbox" id="show-needs" checked />
            <span>
                <strong>Behov</strong>
                <small>Registrerte behov og hendelser</small>
            </span>
        </label>
    </aside>
</div>

<style>
    .map-frame {
        position: relative;
        margin: 32px auto;
        width: 92%;
        max-width: 1500px;
        border: 3px solid white;
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 18px 40px rgba(20, 45, 60, 0.22);
    }

    #map {
        height: 72vh;
        min-height: 450px;
        width: 100%;
    }
    .map-panel {
        position: absolute;
        top: 24px;
        left: 24px;
        z-index: 1000;
        width: 320px;
        max-width: calc(100% - 48px);
        box-sizing: border-box;
        padding: 24px;
        background: rgba(255, 255, 255, 0.96);
        border-radius: 24px;
        box-shadow: 0 10px 28px rgba(20, 45, 60, 0.18);
        color: #142b3b;
    }

    .map-panel h2 {
        margin: 0 0 24px;
        padding: 14px;
        background: #1d705b;
        border-radius: 14px;
        color: white;
        font-size: 20px;
        text-align: center;
    }

    .map-panel-heading {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.5px;
        color: #566570;
    }

    .map-layer-row {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 18px 0;
        border-top: 1px solid #e5ebe8;
        cursor: pointer;
    }

    .map-layer-row input {
        width: 22px;
        height: 22px;
        accent-color: #1d705b;
        flex-shrink: 0;
    }

    .map-layer-row strong,
    .map-layer-row small {
        display: block;
    }

    .map-layer-row small {
        margin-top: 5px;
        color: #566570;
        font-size: 13px;
    }
</style>

@section Scripts {
    <script src="~/js/map-utils.js"></script>
    <script>
        var map = L.map('map', {
            zoomControl: false
        }).setView([58.1467, 7.9956], 11);
        
        // Samler ressurser og behov i hvert sitt kartlag
        var resourceLayer = L.layerGroup().addTo(map);
        var needLayer = L.layerGroup().addTo(map);
        
        // Viser eller skulder ressursene
        document.getElementById('show-resources').addEventListner('change', function(){
            if (this.checked) {
                map.addLayer(resourceLayer);
            } else {
                map.removeLayer(resourceLayer);
            }
        });
        
        // Viser elle skjuler behovene
        document.getElementById('show-needs').addEventListener('change', function(){
            if (this.checked) {
                map.addLayer(needLayer);
            } else{
                map.removeLayer(needLayer);
            }
        });
        
        
        // Plasserrer zoomknappene øverst til høyre
        L.control.zoom({
            position: 'topright'
        }).addTo(map);
        
        // Viser avstander i metert og kilometer
        L.control.scale({
            position: 'bottomright',
            imperial: false
        }).addTo(map);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);

        fetch('/Kart/Data')
            .then(response => response.json())
            .then(punkter => {
                punkter.forEach(function (p) {
                    var marker = L.circleMarker([p.latitude, p.longitude], {
                        radius: 9,
                        fillColor: getMarkerColor(p),
                        color: '#000',
                        weight: 1,
                        fillOpacity: 0.9
                    }).addTo(map);

                    marker.bindPopup(
                        '<strong>' + p.type + '</strong><br>' +
                        'Kategori: ' + p.kategori + '<br>' +
                        'Status: ' + p.status + '<br>' +
                        (p.prioritet ? 'Prioritet: ' + p.prioritet + '<br>' : '') +
                        'Kontakt: ' + p.kontaktpunkt + '<br>' +
                        p.beskrivelse
                    );
                });
            })
            .catch(error => {
                console.error('Klarte ikke å hente kartdata:', error);
            });
        fetch('@Url.Action("Geo", "Resource")')
            .then(response => {
                if (!response.ok) {
                    throw new Error('Kunne ikke hente ressurser');
                }
                return response.json();
            })
            .then(resources => {
                resources.forEach(function (r) {
                    const color = getMarkerColor({
                        kategori: 'ressurs',
                        status: r.status,
                    })
                    
                    let marker;
                    
                    // Vis den lagrede formen npr ressursen har formdata
                    if (r.geometryJson) {
                        const geometry = JSON.parse(r.geometryJson);

                        marker = L.geoJSON(geometry, {
                            style: {
                                color: color,
                                weight: 3,
                                fillColor: color,
                                fillOpacity: 0.25,
                            },
                            pointToLayer: function (feature, latlng){
                                const radius = feature.properties?.radius;
                                
                                if (typeof radius === 'number' && radius > 0) {
                                    return L.circle(latlng,{
                                        radius: radius,
                                        color: color,
                                        fillOpacity: 0.25,
                                    });
                                }
                                return L.circleMarker(latlng, {
                                    radius: 9,
                                    fillColor: color,
                                    color: '#000',
                                    fillOpacity: 0.9,
                                });
                            }
                        }).addTo(resourceLayer);
                    } else {

                        marker = L.circleMarker(
                            [r.latitude, r.longitude],
                            {
                                radius: 9,
                                fillColor: getMarkerColor({
                                    kategori: 'ressurs',
                                    status: r.status
                                }),
                                color: '#000',
                                weight: 1,
                                fillOpacity: 0.9
                            }
                        ).addTo(resourceLayer);
                    }

                    const popup = document.createElement('div');

                    const title = document.createElement('strong');
                    title.textContent = r.type;

                    const info = document.createElement('p');
                    info.textContent =
                        'Område: ' + (r.area ?? '') +
                        ' – Status: ' + (r.status ?? '');

                    const link = document.createElement('a');
                    link.href = '@Url.Action("Details", "Resource")'
                        + '?id=' + encodeURIComponent(r.id);
                    link.textContent = 'Se detaljer';

                    popup.append(title, info, link);
                    marker.bindPopup(popup);
                });
            })
            .catch(error => {
                console.error('Klarte ikke å hente ressurser:', error);
            });


            // Henter registrerte behov fra NeedController og viser dem på felleskartet.
fetch('@Url.Action("Geo", "Need")')
    .then(response => {
        if (!response.ok) {
            throw new Error('Kunne ikke hente behov');
        }
        return response.json();
    })
    .then(needs => {
        needs.forEach(function (need) {
        const color = getMarkerColor(need);
        let marker;

// Vis den lagrede formen hvis behovet har formdata.
        if (need.geometryJson) {
            const geometry = JSON.parse(need.geometryJson);

            marker = L.geoJSON(geometry, {
                style: {
                    color: color,
                    weight: 3,
                    fillColor: color,
                    fillOpacity: 0.25
                },
                pointToLayer: function (feature, latlng) {
                    const radius = feature.properties?.radius;

                    // Gjenopprett sirkler med den lagrede radiusen.
                    if (typeof radius === 'number' && radius > 0) {
                        return L.circle(latlng, {
                            radius: radius,
                            color: color,
                            fillOpacity: 0.25
                        });
                    }

                    return L.circleMarker(latlng, {
                        radius: 9,
                        fillColor: color,
                        color: '#000',
                        weight: 1,
                        fillOpacity: 0.9
                    });
                }
            }).addTo(needLayer);
        } else {
            // Eldre behov uten formdata vises som et punkt.
            marker = L.circleMarker(
                [need.latitude, need.longitude],
                {
                    radius: 9,
                    fillColor: color,
                    color: '#000',
                    weight: 1,
                    fillOpacity: 0.9
                }
            ).addTo(needLayer);
        }

            // Tekstinnhold slik at brukerens tekst ikke tolkes som HTML.
            const popup = document.createElement('div');

            const title = document.createElement('strong');
            title.textContent = need.type;

            const info = document.createElement('p');
            info.textContent = need.beskrivelse;

            const link = document.createElement('a');
            link.href = '@Url.Action("Confirmation", "Need")'
                + '?id=' + encodeURIComponent(need.id);
            link.textContent = 'Se detaljer';

            popup.append(title, info, link);
            marker.bindPopup(popup);
        });
    })
    .catch(error => {
        console.error('Klarte ikke å hente behov:', error);
    });

    </script>
}