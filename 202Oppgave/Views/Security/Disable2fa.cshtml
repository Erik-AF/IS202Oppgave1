@model _202Oppgave.ViewModels.Account.ConfirmPasswordViewModel

@{
    ViewData["Title"] = "Deaktiver tofaktorautentisering";
}

<section class="auth-card">

    <div class="auth-heading">

        <p class="auth-eyebrow">SIKKERHET</p>

        <h1>Deaktiver tofaktorautentisering</h1>

    </div>

    <div class="alert alert-warning">

        Kontoen din vil være mindre beskyttet dersom
        du deaktiverer tofaktorautentisering.

        Eksisterende gjenopprettingskoder vil bli ugyldige.

    </div>

    <form asp-controller="Security"
          asp-action="Disable2fa"
          method="post">

        <div asp-validation-summary="ModelOnly"
             class="auth-validation"></div>

        <div class="auth-field">

            <label asp-for="Password"></label>

            <input asp-for="Password"
                   type="password"
                   autocomplete="current-password" />

            <span asp-validation-for="Password"
                  class="auth-validation"></span>

        </div>

        <div class="auth-field">

            <label asp-for="Code"></label>

            <input asp-for="Code"
                   type="text"
                   inputmode="numeric"
                   autocomplete="one-time-code"
                   maxlength="6" />

            <span asp-validation-for="Code"
                  class="auth-validation"></span>

        </div>

        <button type="submit"
                class="btn btn-danger w-100">

            Deaktiver tofaktorautentisering

        </button>

    </form>

    <div class="auth-bottom">

        <a asp-action="Index">Avbryt</a>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}