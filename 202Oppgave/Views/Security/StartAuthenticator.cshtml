@model _202Oppgave.ViewModels.Account.ConfirmPasswordViewModel

@{
    ViewData["Title"] = "Aktiver tofaktorautentisering";
}

<section class="auth-card">

    <div class="auth-heading">

        <p class="auth-eyebrow">SIKKERHET</p>

        <h1>Aktiver tofaktorautentisering</h1>

        <p>
            Bekreft passordet ditt før du fortsetter.
        </p>

    </div>

    <form asp-controller="Security"
          asp-action="StartAuthenticator"
          method="post">

        <div asp-validation-summary="ModelOnly"
             class="auth-validation"></div>

        <div class="auth-field">

            <label asp-for="Password"></label>

            <input asp-for="Password"
                   type="password"
                   autocomplete="current-password" />

            <span asp-validation-for="Password"
                  class="auth-validation"></span>

        </div>

        <button type="submit" class="auth-submit">
            Fortsett
        </button>

    </form>

    <div class="auth-bottom">

        <a asp-action="Index">Avbryt</a>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}