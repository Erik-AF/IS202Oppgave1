@model List<_202Oppgave.ViewModels.NeedViewModel>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Registrerte behov";
}

<div class="container home-content">
    <h1>Registrerte behov</h1>

    @if (Model.Count == 0)
{
    <p>Ingen behov er registrert ennå.</p>
}

@foreach (var need in Model)
{
    <div class="card" style="padding:1rem; margin-bottom:1rem;">
        <h2>@need.Type</h2>
        <p>Lokasjon: @need.Location</p>
        <p>Prioritet: @need.Priority</p>
        <p>Beskrivelse: @need.Description</p>
        <p>Frist for hjelp: @need.Deadline?.ToString("dd.MM.yyyy HH:mm")</p>
    </div>
}

</div>
