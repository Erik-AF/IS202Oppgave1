@model List<_202Oppgave.Models.Need>
@using _202Oppgave.DataAccess.Repositories
@inject IAllocationRepository AllocationRepo

@{
    ViewData["Title"] = "Registrerte behov";
    
    // Allokerte ressurser for alle behov, hentet i én spørring.
    // Nøkkel = behovets Id, verdi = navnene på ressursene.
    var allocated = await AllocationRepo.GetResourceNamesByNeedAsync();
}




<div class="container rl">
    <header class="rl-head">
        <div><p class="eyebrow">Der hjelpen trengs</p><h1>Registrerte behov</h1><p>Finn lokale behov og se hvordan du kan bidra.</p></div>
        <a class="rl-btn" asp-action="Create">Registrer nytt behov</a>
    </header>

    <div class="rl-layout">
        <form class="rl-filter" data-need-filter role="search">
            <h2>Finn et behov</h2>
            <label class="rl-label" for="need-search">Søk etter behov eller sted</label>
            <input class="rl-input" id="need-search" type="search" placeholder="For eksempel strøm eller Kristiansand" />
            <label class="rl-label" for="need-priority">Prioritet</label>
            <select class="rl-input" id="need-priority"><option value="">Alle behov</option><option value="urgent">Akutt</option><option value="planned">Ikke akutt</option></select>
            <button class="rl-btn rl-btn--full" type="submit">Vis behov</button>
            <button class="rl-reset" type="reset">Nullstill filter</button>
        </form>
        <section aria-label="Behovslisten">
        <p class="rl-found" id="need-count" role="status">@Model.Count behov funnet</p>
        <div class="rl-empty" id="need-no-matches" hidden>Ingen behov passer med søket. Prøv et annet sted eller en annen prioritet.</div>
    @if (!Model.Any())
    {
        <div class="rl-empty"><p>Ingen behov er registrert ennå.</p></div>
    }
    else
    {
        <ul class="rl-list">
            @foreach (var need in Model)
            {
                var isUrgent = need.Priority == _202Oppgave.ViewModels.NeedPriority.Akutt;
                <li data-need-item data-priority="@(isUrgent ? "urgent" : "planned")">
                    <a class="rl-row" asp-action="Confirmation" asp-route-id="@need.Id">
                        <div>
                            <h2>@need.Type</h2>
                            <p class="rl-desc">@need.Description</p>
                            <ul class="rl-meta">
                                <li>@need.Location</li>
                                <li>Frist: @need.Deadline.ToString("dd.MM.yyyy HH:mm")</li>
                            </ul>
                            @* Ressurser som er allokert til behovet *@
                            @if (allocated.TryGetValue(need.Id, out var names))
                            {
                                <p style="margin:0.5rem 0 0; font-size:0.9rem;">
                                    <strong style="font-weight:500;">Allokert (@names.Count):</strong>
                                    @string.Join(", ", names)
                                </p>
                            }
                            else
                            {
                                <p style="margin:0.5rem 0 0; font-size:0.9rem; color:#5b5f66;">Ingen ressurser allokert ennå</p>
                            }
                        </div>
                        <div class="rl-side">
                            <span class="rl-status">
                                <span class="rl-dot @(isUrgent ? "rl-dot--red" : "rl-dot--yellow")" aria-hidden="true"></span>
                                @(isUrgent ? "Akutt" : "Ikke akutt")
                            </span>
                            <span class="rl-more">Se detaljer</span>
                        </div>
                    </a>
                </li>
            }
        </ul>
        
    }
        </section>
    </div>
</div>