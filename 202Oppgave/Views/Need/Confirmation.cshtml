@model _202Oppgave.Models.Need

@* Gjenbruker bekreftelsessiden når et behov åpnes fra oversikten. *@

@{
    ViewData["Title"] = "Registrert behov";
}

<div class="container home-content">
    <a class="back-link" asp-action="Index">← Til oversikten</a><div class="card detail-card">
        <p class="eyebrow">Registrert behov</p><h1>@Model.Type</h1>
        <p>Behovet er registrert.</p>
        <p><strong>Lokasjon:</strong> @Model.Location</p>
        <p><strong>Prioritet:</strong> @(Model.Priority == _202Oppgave.ViewModels.NeedPriority.Akutt ? "Akutt" : "Ikke akutt")</p>
        <p><strong>Beskrivelse:</strong> @Model.Description</p>
        <p><strong>Frist for hjelp:</strong> @Model.Deadline.ToString("dd.MM.yyyy HH:mm")</p>
        <p><strong>Breddegrad:</strong> @Model.Latitude</p>
        <p><strong>Lengdegrad:</strong> @Model.Longitude</p>
        <div id="details-map" style="height:350px; width:100%; margin-bottom:1rem;"></div>
        <div class="detail-actions"><p><a asp-action="Index" class="btn btn-primary" style="color:#fff; text-decoration:none; display:inline-block; padding:0.65rem 1.4rem; border-radius:999px;">Se alle behov</a></p>
        <a asp-action="Create">Registrer et nytt behov</a>
        <p>
    <a asp-action="Edit" asp-route-id="@Model.Id"
       class="btn btn-primary"
       style="color:#fff; text-decoration:none; display:inline-block; padding:0.65rem 1.4rem; border-radius:999px;">
        Rediger
    </a>
</p>
@* Ber om bekreftelse for å unngå at et behov slettes ved et uhell. *@
<form asp-action="Delete" asp-route-id="@Model.Id" method="post"
      onsubmit="return confirm('Er du sikker på at du vil slette dette behovet?');"
      style="display:inline;">
    <button type="submit" class="btn"
            style="background:var(--brick); color:#fff; padding:0.65rem 1.4rem; border-radius:999px; border:none; cursor:pointer;">
        Slett
    </button>
</form>
    </div>
    </div>
</div>

@section Scripts {
    <script>
        // JSON sørger for at koordinatene får punktum som desimalskille i JavaScript.
        const position = [@Json.Serialize(Model.Latitude), @Json.Serialize(Model.Longitude)];
        const map = L.map('details-map').setView(position, 15);
        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);
        L.marker(position).addTo(map);
    </script>
}