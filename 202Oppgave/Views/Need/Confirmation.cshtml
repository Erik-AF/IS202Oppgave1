@model _202Oppgave.ViewModels.NeedViewModel

@{
    ViewData["Title"] = "Innsendt behov";
}
<div class="container home-content">
<h1>Innsendt behov</h1>

<p>Behovet er registrert og vises i behovsoversikten. Opplysningene lagres midlertidig og forsvinner når appen starter på nytt.</p>

<dl>
    <dt>Type behov</dt>
    <dd>@Model.Type</dd>
    <dt>Lokasjon</dt>
    <dd>@Model.Location</dd>
    <dt>Breddegrad</dt>
    <dd>@Model.Latitude</dd>
    <dt>Lengdegrad</dt>
    <dd>@Model.Longitude</dd>
    <dt>Prioritet</dt>
    <dd>@Model.Priority</dd>
    <dt>Beskrivelse</dt>
    <dd>@Model.Description</dd>
    <dt>Frist for hjelp</dt>
    <dd>@Model.Deadline?.ToString("dd.MM.yyyy HH:mm")</dd>
</dl>

<a asp-controller="Need" asp-action="Create">Registrer et nytt behov</a>
<a asp-controller="Need" asp-action="Index">Se alle behov</a>
</div>