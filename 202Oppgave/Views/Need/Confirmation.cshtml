@* Viser behovet og tilhørende tilbud, med handlinger for brukere som kan behandle dem. *@
@model _202Oppgave.Models.Need
@using _202Oppgave.Models.Authorization

@{
    ViewData["Title"] = "Registrert behov";
}

<div class="container home-content need-design need-details">
    <nav class="need-breadcrumb" aria-label="Brødsmuler">
        <a asp-action="Index">Behov</a><span aria-hidden="true">/</span>
        <span aria-current="page">@Model.Type</span>
    </nav>
    <div class="card detail-card">
        <p class="eyebrow">Registrert behov</p><h1>@Model.Type</h1>
        <p>Behovet er registrert.</p>
        <p><strong>Lokasjon:</strong> @Model.Location</p>
        <p><strong>Prioritet:</strong> @(Model.Priority == _202Oppgave.ViewModels.NeedPriority.Akutt ? "Akutt" : "Ikke akutt")</p>
        <p><strong>Beskrivelse:</strong> @Model.Description</p>
        <p><strong>Frist for hjelp:</strong> @Model.Deadline.ToString("dd.MM.yyyy HH:mm")</p>
        <p><strong>Breddegrad:</strong> @Model.Latitude</p>
        <p><strong>Lengdegrad:</strong> @Model.Longitude</p>
        <div id="details-map" ></div>

        @if (TempData["Message"] is string message)
        {
            <p class="need-details-message">@message</p>
        }

        @if (User.IsInRole(_202Oppgave.Models.Authorization.RoleNames.PublicActor)
            || User.IsInRole(_202Oppgave.Models.Authorization.RoleNames.Admin))
        {
            <p><a class="btn btn-primary" asp-controller="Allocation" asp-action="FromNeed" asp-route-needId="@Model.Id">Alloker ressurser →</a></p>
        }

        @await Component.InvokeAsync("AllocatedResources", new { needId = Model.Id })
        <div class="detail-actions"><p><a asp-action="Index" class="btn btn-primary">Se alle behov</a></p>
        @if (User.Identity?.IsAuthenticated == true && User.IsInRole(RoleNames.ResourceProvider))
        {
            <p><a asp-controller="Allocation" asp-action="OfferToNeed" asp-route-needId="@Model.Id"
                  class="btn btn-primary">Alloker ressurs</a></p>
        }
        @if (User.IsInRole(RoleNames.PublicActor) ||User.IsInRole(RoleNames.Admin))
        {
            <a class="rl-btn" asp-action="Create">
                Registrer et nytt behov
            </a>
        }
        @if (Model.CanManage)
        {
        <p>
    <a asp-action="Edit" asp-route-id="@Model.Id"
       class="btn btn-primary"
      >
        Rediger
    </a>
</p>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post"
      onsubmit="return confirm('Er du sikker på at du vil slette dette behovet?');"
>
    <button type="submit" class="btn need-delete-button">
        Slett
    </button>
</form>
        }
    </div>
    </div>
</div>

@section Scripts {
    <script>

        const position = [@Json.Serialize(Model.Latitude), @Json.Serialize(Model.Longitude)];
        const map = L.map('details-map').setView(position, 15);
        const standardLayer = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);
        addMapLayers(map, standardLayer);
        L.marker(position).addTo(map);
    </script>
}