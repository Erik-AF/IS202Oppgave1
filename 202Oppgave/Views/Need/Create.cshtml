
@model _202Oppgave.ViewModels.NeedViewModel

@{
ViewData["Title"] = "Registrer behov";
}

@section Head {
<style>
    /* Kartets størrelse */
    #need-map {
        height: 550px;
        width: 100%;
        border-radius: 12px;
    }

    /* Små koordinatfelt ved siden av hverandre under kartet */
    .resource-coords {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-top: 0.75rem;
    }

    /* Mindre tekst, så feltene ikke tar fokus fra skjemaet */
    .resource-coords label,
    .resource-coords input {
        font-size: 0.85rem;
    }

    /* Grå bakgrunn viser at feltene ikke kan redigeres.
       Må være mer spesifikk enn .form-control[readonly] i components.css */
    .resource-coords .form-control[readonly] {
        background-color: #edeeec;
        color: var(--muted);
        cursor: default;
    }

    /* Ingen blå fokusramme når man klikker i feltene */
    .resource-coords .form-control[readonly]:focus {
        border-color: var(--line-strong);
        box-shadow: none;
    }

    /* På mobil legges kartet under skjemaet */
    @@media (max-width: 800px) {
        #need-layout {
            grid-template-columns: 1fr;
        }
    }
</style>
}

<div class="container home-content">
    <a class="back-link" asp-action="Index">← Til behovsoversikten</a>
    <p class="eyebrow">Meld inn behov</p>
    <h1>Registrer behov</h1>
    <p class="page-intro">Beskriv hva som trengs, velg prioritet og marker hvor hjelpen skal frem.</p>

    @* Skjemaet omslutter både feltene og kartet, slik at koordinatene under kartet sendes med *@
    <form id="need-layout"
          class="resource-layout"
          asp-controller="Need"
          asp-action="Create"
          method="post">

        @* Venstre kolonne: skjemafeltene *@
        <div class="card" style="padding:2rem; min-width:0;">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"
                 style="margin-bottom:1rem;">
            </div>

            @* Skjult felt som sender kartformen sammen med skjmaet. *@
            <input asp-for="GeometryJson" type="hidden" />


            <div style="margin-bottom:1rem;">
                <label asp-for="Type">Type behov</label>
                <input asp-for="Type" class="form-control" />
                <span asp-validation-for="Type" class="text-danger"></span>
            </div>

            <div style="margin-bottom:1rem;">
                <label asp-for="Description">Beskrivelse</label>
                <textarea asp-for="Description"
                          class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div style="margin-bottom:1rem;">
                <label asp-for="Location">Adresse eller sted for behovet</label>
                <input asp-for="Location" class="form-control" />
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>

            <div style="margin-bottom:1rem;">
                <label asp-for="Deadline">Frist for hjelp</label>
                <input asp-for="Deadline"
                       class="form-control"
                       type="datetime-local" />
                <span asp-validation-for="Deadline" class="text-danger"></span>
            </div>

            <div style="margin-bottom:1rem;">
                <label asp-for="Priority">Prioritet</label>

                <select asp-for="Priority"
                        class="form-select">
                    <option value="">Velg prioritet</option>

                    @foreach (var priority in Html.GetEnumSelectList<_202Oppgave.ViewModels.NeedPriority>())
                    {
                    <option value="@priority.Value"
                            selected="@priority.Selected">
                        @(priority.Text == "IkkeAkutt" ? "Ikke akutt" : priority.Text)
                    </option>
                    }
                </select>

                <span asp-validation-for="Priority"
                      class="text-danger"></span>
            </div>

            <button type="submit"
                    class="btn btn-primary"
            >
                Registrer
            </button>

        </div>

        <div class="resource-map-panel"><h2 class="map-panel-title">Velg plassering</h2><p>
                Velg en posisjon eller tegn et område på kartet.
                Kun én markering kan registreres om gangen.
            </p>

            <div id="need-map"></div>

            @* Koordinatene fylles automatisk når man markerer i kartet.
               Feltene er readonly, men sendes likevel med skjemaet. *@
            <div class="resource-coords">
                <div>
                    <label asp-for="Latitude">Breddegrad</label>
                    <input asp-for="Latitude" class="form-control" readonly />
                    <span asp-validation-for="Latitude" class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="Longitude">Lengdegrad</label>
                    <input asp-for="Longitude" class="form-control" readonly />
                    <span asp-validation-for="Longitude" class="text-danger"></span>
                </div>
            </div>
        </div>

    </form>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script src="~/js/map-utils.js" asp-append-version="true"></script>

<script>
    // Opprett kartet
    const map = L.map('need-map')
        .setView([58.1467, 7.9956], 13);

    // OpenStreetMap
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(map);

    // Gruppe for tegninger
    const drawnItems = new L.FeatureGroup();
    map.addLayer(drawnItems);

    // Tilpass linjeverktøyet
    const originalAddVertex = L.Draw.Polyline.prototype.addVertex;

    L.Draw.Polyline.include({
        addVertex: function (latlng) {
            const result = originalAddVertex.call(this, latlng);

            if (this._markers.length === 1) {
                const firstMarker = this._markers[0];

                firstMarker.off('click');

                firstMarker.on('click', (event) => {
                    if (this._markers.length < 3) {
                        return;
                    }

                    if (event.originalEvent) {
                        L.DomEvent.stop(event.originalEvent);
                    }

                    const firstPoint =
                        this._markers[0].getLatLng();

                    originalAddVertex.call(this, firstPoint);

                    this.completeShape();
                });
            }

            return result;
        }
    });


    const priorityInput = document.getElementById('Priority');

    function needAreaStyle() {
        return getMapAreaStyle({
            kategori: 'behov',
            prioritet: priorityInput.value === '2' ? 'Akutt' : 'Planlagt'
        });
    }

    function styleNeedLayer(layer) {
        if (typeof layer.setStyle === 'function') layer.setStyle(needAreaStyle());
    }

    // Leaflet.Draw-verktøy
    const drawControl = new L.Control.Draw({
        draw: {
            polygon: false,
            polyline: { shapeOptions: needAreaStyle() },
            circle: { shapeOptions: needAreaStyle() },
            rectangle: { shapeOptions: needAreaStyle() },
            marker: true,
            circlemarker: false
        },
        edit: {
            featureGroup: drawnItems,
            remove: true
        }
    });

    map.addControl(drawControl);

    // Koordinatfeltene
    const latitudeInput =
        document.getElementById('Latitude');

    const longitudeInput =
        document.getElementById('Longitude');

    // Henter feltet som skal innehodlde kartformen
    const geometryInput = document.getElementById('GeometryJson');

    // Adresseforslag etter at brukeren velger eller redigerer en kartform.
    const addressInput = document.getElementById('Location');
    const addressStatus = document.createElement('small');
    addressStatus.setAttribute('role', 'status');
    addressStatus.style.display = 'block';
    addressStatus.textContent = 'Adresseforslag fra Kartverket. Du kan rette stedet manuelt.';
    addressInput.insertAdjacentElement('afterend', addressStatus);

    let addressVersion = 0;
    let addressTimer;
    let addressController;

    function cancelAddressLookup() {
        ++addressVersion;
        clearTimeout(addressTimer);
        addressController?.abort();
    }

    addressInput.addEventListener('input', function () {
        cancelAddressLookup();
        addressStatus.textContent = 'Manuelt angitt adresse eller sted.';
    });

    function scheduleAddressLookup(latlng) {
        cancelAddressLookup();
        const version = addressVersion;
        addressInput.value = '';
        addressStatus.textContent = 'Henter adresseforslag fra Kartverket …';

        addressTimer = setTimeout(async function () {
            const controller = new AbortController();
            addressController = controller;
            const query = new URLSearchParams({
                lat: latlng.lat.toString(),
                lon: latlng.lng.toString()
            });

            try {
                const response = await fetch(
                    '@Url.Action("ReverseGeocode", "Kart")' + '?' + query,
                    { signal: controller.signal }
                );
                if (!response.ok) throw new Error('Adresseoppslag feilet');
                const result = await response.json();
                if (version !== addressVersion) return;

                addressInput.value = result.address ?? '';
                addressStatus.textContent = result.address
                    ? 'Nærmeste adresse innen 100 meter, fra Kartverket. Kontroller og rett ved behov.'
                    : 'Ingen adresse innen 100 meter. Skriv inn adresse eller sted manuelt.';
            } catch (error) {
                if (version !== addressVersion || error.name === 'AbortError') return;
                addressStatus.textContent = 'Kunne ikke hente adresse. Skriv inn adresse eller sted manuelt.';
            }
        }, 350);
    }

    // Lagrer formen i det skjulte feltet.
    function updateGeometry(layer) {
        const geometry = layer.toGeoJSON();

        // Tar også vare på radius hvis formen er en sirkel.
        if (layer instanceof L.Circle) {
            geometry.properties.radius = layer.getRadius();
        }

        geometryInput.value = JSON.stringify(geometry);
    }

    // Oppdater koordinater for alle figurtyper
    function updateCoordinates(layer) {
        updateGeometry(layer);
        let latlng;

        if (layer instanceof L.Marker ||
            layer instanceof L.Circle) {
            latlng = layer.getLatLng();
        } else if (typeof layer.getBounds === 'function') {
            latlng = layer.getBounds().getCenter();
        }

        if (latlng) {
            latitudeInput.value = latlng.lat.toFixed(6);
            longitudeInput.value = latlng.lng.toFixed(6);
            scheduleAddressLookup(latlng);
        }
    }

    // Gjenopprett formen etter skjemafeil.
    if (geometryInput.value) {
        const geometry = JSON.parse(geometryInput.value);

        const restored = L.geoJSON(prepareMapGeometry(geometry), {
            style: needAreaStyle(),
            pointToLayer: function (feature, latlng) {
                const radius = feature.properties?.radius;

                if (typeof radius === 'number' && radius > 0) {
                    return L.circle(latlng, { ...needAreaStyle(), radius: radius });
                }

                return L.marker(latlng);
            }
        });

        restored.eachLayer(function (layer) {
            drawnItems.addLayer(layer);
        });

        map.fitBounds(drawnItems.getBounds(), {
            padding: [20, 20],
            maxZoom: 15
        });
    } else if (latitudeInput.value && longitudeInput.value) {
        const lat = Number(latitudeInput.value.replace(',', '.'));
        const lng = Number(longitudeInput.value.replace(',', '.'));

        if (Number.isFinite(lat) && Number.isFinite(lng)) {
            drawnItems.addLayer(L.marker([lat, lng]));
            map.setView([lat, lng], 13);
        }
}

    // Når en ny markering opprettes
    map.on('draw:created', function (e) {
        drawnItems.clearLayers();

        let layer = e.layer;
        // Et lukket omriss blir et fylt område.
        if (layer instanceof L.Polyline && !(layer instanceof L.Polygon)) {
            const points = layer.getLatLngs();
            if (points.length >= 4 && points[0].equals(points[points.length - 1])) {
                layer = L.polygon(points.slice(0, -1), needAreaStyle());
            }
        }
        styleNeedLayer(layer);
        drawnItems.addLayer(layer);

        updateCoordinates(layer);
    });

    // Når markeringen redigeres
    map.on('draw:edited', function (e) {
        e.layers.eachLayer(function (layer) {
            updateCoordinates(layer);
        });
    });

    // Tømmer koordinater og formdata når markeringen slettes.
    map.on('draw:deleted', function () {
        latitudeInput.value = '';
        longitudeInput.value = '';
        geometryInput.value = '';
        cancelAddressLookup();
        addressInput.value = '';
        addressStatus.textContent = 'Velg en ny plassering på kartet.';
    });


    // Oppdater fargene når prioriteten endres.
    priorityInput.addEventListener('change', function () {
        drawnItems.eachLayer(styleNeedLayer);
        drawControl.setDrawingOptions({
            polyline: { shapeOptions: needAreaStyle() },
            circle: { shapeOptions: needAreaStyle() },
            rectangle: { shapeOptions: needAreaStyle() }
        });
    });

    // Oppdater kartstørrelsen
    setTimeout(function () {
        map.invalidateSize();
    }, 100);

    // Aktiver verktøylinjens markør ved åpning av et tomt skjema.
    if (drawnItems.getLayers().length === 0) {
        drawControl._toolbars.draw._modes.marker.handler.enable();
    }
</script>
}




